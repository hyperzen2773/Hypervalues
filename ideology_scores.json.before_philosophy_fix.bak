{
    "National Syndicalism": {
        "d": "Organizes the nation into syndicates of workers and employers under the state: syndicalism and corporatism, ethical statism, romantic nationalism, reactionary modernism and regimentalism, putting national unity before class struggle. It rejects communization, state socialism, laissez-faire, representative democracy, civil liberalism, cosmopolitanism and internationalism.",
        "s": "syndicalism:1|corporatism:0.6|laissez_faire:-1|state_socialism:-0.8|communization:-1|representative_democracy:-1|ethical_statism:0.8|civil_liberalism:-1|reactionary_modernism:0.5|romantic_nationalism:0.8|Cosmopolitanism:-1|Internationalism:-1|regimentalism:0.5|hierarchical_communism:0.7|syndicracy:0.7|organic_democracy:0.4|productive_democracy:0.5|organic_statism:0.6|futurism:0.4|state_corporatism:0.6|protectionism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Brazilian Integralism": {
        "d": "Advocates an Integral State of corporatism: society organized into corporations of family, municipality and profession under strong, centralized authority. It is grounded in religious traditionalism (God, Fatherland, Family), cultural nationalism and religious authoritarianism, and it rejects civil liberalism, representative democracy, laissez-faire capitalism, state socialism and communism. It defines the nation by culture and spirit and rejects racial nationalism.",
        "s": "corporatism:1|religious_traditionalism:0.8|religious_authoritarianism:0.6|cultural_nationalism:0.8|centralism:0.5|civil_liberalism:-1|laissez_faire:-0.8|state_socialism:-1|communization:-1|representative_democracy:-0.7|racial_nationalism:-1|organic_democracy:0.5|organic_statism:0.7|protectionism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Italian Fascism": {
        "d": "Holds that the state embodies the nation: totalism and ethical statism, corporatism joining workers and employers under a single party and an autocratic leader, centralism, romantic nationalism and imperialism. It rejects representative democracy, referendum democracy, civil libertarianism, permissivism, laissez-faire, communization, state socialism, cosmopolitanism, internationalism and non-interventionism.",
        "s": "totalism:0.98|ethical_statism:1|organic_statism:1|corporatism:0.84|state_corporatism:0.9|syndicracy:0.6|romantic_nationalism:0.8|cultural_nationalism:0.83|Imperialism:0.9|centralism:0.8|partocracy:0.34|autocracy:0.73|regimentalism:0.7|industrialism:0.5|futurism:0.67|representative_democracy:-1|referendum_democracy:-0.7|civil_liberalism:-1|civil_libertarianism:-1|permissivism:-0.8|laissez_faire:-1|state_socialism:-0.8|communization:-1|Cosmopolitanism:-1|Internationalism:-1|Non_Interventionism:-0.8|pacifism:-1|reputationalism:-0.6|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.6|syndicalism:0.62|ethnic_nationalism:-0.68|racial_nationalism:-0.87|alternative_modernism:0.78|reactionary_modernism:0.6|hierarchical_communism:0.76|religious_nationalism:-0.45|pan_nationalism:-0.23|protectionism:0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Evolianism": {
        "d": "A Traditionalist outlook that sees modern equality, democracy and materialism as decline, and seeks an order led by spiritual authority and a warrior aristocracy.",
        "s": "perennial_traditionalism:1|aristocracy:1|feudalism:0.5|reactionaryism:0.7|representative_democracy:-1|progressivism:-1|social_progressivism:-1|civil_liberalism:-1|laissez_faire:-1|state_socialism:-1|communization:-1|amoralism:-0.7|ochlocracy:-0.7|organic_statism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Futurism": {
        "d": "Celebrates speed, machines, industry and constant change. Industrialism and Promethean mastery over nature drive an alternative modernism and energetic national expansion (imperialism), while conservatism, traditionalist conservatism, reactionaryism, primitivism and neo-Luddism are rejected as reverence for the past.",
        "s": "industrialism:1|prometheanism:0.6|alternative_modernism:0.7|Imperialism:0.6|conservatism:-1|traditionalist_conservatism:-1|reactionaryism:-1|primitivism:-1|neoluddism:-1|convivialism:-0.6|futurism:0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National-Socialism": {
        "d": "A racial-nationalist doctrine holding that the nation is a community of blood, that races are unequal, and that the state exists to preserve and expand the German or Aryan people under a single leader and party. Society is to be organized as a unified people's community in which all institutions are brought into line with the party under the leader principle, and individual rights and class interests are subordinate to the race and the nation. Private enterprise is permitted only so far as it serves state goals, and the economy is directed toward rearmament, self-sufficiency and expansion; territory (living space) is to be won for the race through war. Supporters oppose liberal democracy, Marxism, internationalism and Jews, whom they regard as the race's enemy.",
        "s": "totalism:1|hypercentralism:0.9|autocracy:1|racial_nationalism:1|pan_nationalism:0.7|Imperialism:0.9|dirigisme:0.6|ethical_statism:0.5|reactionary_modernism:0.5|civil_libertarianism:-1|permissivism:-1|laissez_faire:-0.8|civil_liberalism:-1|representative_democracy:-1|state_socialism:-0.8|communization:-1|Cosmopolitanism:-1|Internationalism:-1|pacifism:-0.8|multiculturalism:-0.8|polycentrism:-0.6|reputationalism:-0.6|subsidiarity:-0.7|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.7|state_corporatism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neo-Nazism": {
        "d": "Postwar revival of National Socialism: holds that the nation is defined by race, that races are unequal, and that a total state under one leader should preserve the white or Aryan race. It is a loose set of groups and movements, not a regime, that adopts the symbols, leader principle and racial doctrine of the Third Reich and often extends its idea of the nation beyond Germany to a shared white or European identity. Supporters oppose liberal democracy, communism, immigration and multiculturalism, and are hostile to Jews. It arises after the fall of the Third Reich and operates from outside state power as a set of organizations and movements.",
        "s": "racial_nationalism:1|totalism:1|hypercentralism:0.8|autocracy:0.9|ethical_statism:0.5|civil_libertarianism:-1|civil_liberalism:-1|representative_democracy:-1|state_socialism:-0.8|communization:-1|Cosmopolitanism:-1|Internationalism:-1|multiculturalism:-0.8|polycentrism:-0.6|reputationalism:-0.6|subsidiarity:-0.7|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Agrarian Fascism": {
        "d": "Joins fascist state authority to a rural, peasant-based vision of society: holds that the strength of the nation lies in farmland, village life and tradition, directed by a strong leader and a disciplined state. Supporters oppose urban industrial liberalism and communism.",
        "s": "agrarianism:1|agrarian_socialism:0.6|autocracy:0.8|ethical_statism:0.6|romantic_nationalism:0.8|traditionalist_conservatism:0.7|disciplinarianism:0.6|industrialism:-0.6|civil_liberalism:-1|representative_democracy:-1|state_socialism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Strasserism": {
        "d": "The socialist wing of National Socialism: guild-socialist and social-corporatist organization of worker guilds and nationalized key industries, ethical statism and racial nationalism. It rejects laissez-faire, communization, civil liberalism, representative democracy, cosmopolitanism and internationalism, and opposes big capital.",
        "s": "guild_socialism:0.8|social_corporatism:0.6|state_socialism:0.4|racial_nationalism:0.9|ethical_statism:0.6|laissez_faire:-1|communization:-1|civil_liberalism:-1|representative_democracy:-1|Cosmopolitanism:-1|Internationalism:-1|hierarchical_communism:0.5|multiculturalism:-0.8|organic_statism:0.5|protectionism:0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Falangism": {
        "d": "Spanish national-syndicalist doctrine of a single national state: corporatism in vertical syndicates joining workers and employers, ethical statism in which the state embodies the nation's moral unity, romantic nationalism of the fatherland's destiny, centralism and regimentalism, traditionalist conservatism of Catholic tradition, and an imperial Hispanic mission. It rejects civil liberalism, representative democracy, class struggle (communization and state socialism), laissez-faire, regionalism and confederalism.",
        "s": "corporatism:0.9|traditionalist_conservatism:0.6|ethical_statism:0.7|romantic_nationalism:0.8|Imperialism:0.5|centralism:0.8|regimentalism:0.6|regionalism:-0.8|confederalism:-0.8|laissez_faire:-0.8|civil_liberalism:-1|representative_democracy:-1|state_socialism:-0.8|communization:-1|patchwork:-0.7|organic_statism:0.7|panarchy:-0.6|state_corporatism:0.8|protectionism:0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Sansepolcrismo": {
        "d": "The founding program of the Italian Fascist movement: civic nationalism and imperialist national expansion combined with social-reform demands such as worker representation through corporatism, heavy progressive taxation, land reform and progressivism.",
        "s": "Progressive_Taxation:0.8|progressivism:0.6|civic_nationalism:0.5|Imperialism:0.5|corporatism:0.4|regressive_taxation:-0.8|productive_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Ecofascism": {
        "d": "Ties environmental protection to nationalism: conservationism and environmentalism joined to ethnic nationalism, holding that the nation's land and people must be defended from overpopulation, immigration and industrial degradation. A strong ethical state enforces this order, rejecting cosmopolitanism, globalism, civil liberalism, laissez-faire and industrialism, and favors isolationism that closes borders to migration and global trade.",
        "s": "conservationism:0.8|environmentalism:0.8|ethnic_nationalism:0.8|ethical_statism:0.6|Isolationism:0.6|industrialism:-0.7|laissez_faire:-0.7|Cosmopolitanism:-1|Globalism:-1|civil_liberalism:-0.8|multiculturalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Sorelianism": {
        "d": "Based on the thought of Georges Sorel: syndicalism, in which workers organized in unions and industrial syndicates carry out revolutionary direct action, with the general strike as a social myth and proletarian violence as a class weapon. It scorns parliamentary politics and electoral bargaining, reformist socialism run through the state, bourgeois liberal values and the commerce of unrestrained markets.",
        "s": "syndicalism:1|representative_democracy:-1|laissez_faire:-1|civil_liberalism:-0.8|state_socialism:-0.7|hierarchical_communism:0.7|productive_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Legionarianism": {
        "d": "Romanian Orthodox-Christian nationalism: religious nationalism and religious traditionalism make the nation a spiritual community, led by a charismatic leader (religious authoritarianism) within a corporatist, centralist and regimented movement. It aims to create a new man through discipline, sacrifice, brotherhood and faith, and rejects civil liberalism, representative democracy, communization, state socialism and laissez-faire.",
        "s": "religious_nationalism:1|religious_traditionalism:0.9|religious_authoritarianism:0.7|corporatism:0.7|regimentalism:0.6|centralism:0.5|laissez_faire:-0.7|civil_liberalism:-1|representative_democracy:-1|state_socialism:-0.8|communization:-1|amoralism:-0.7|secular_humanism:-0.8|organic_statism:0.4|state_corporatism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Peronism": {
        "d": "Argentine doctrine of social justice, economic independence and political sovereignty, the Third Position: dirigisme with a state-led economy, social corporatism that organizes labor within a national movement under a strong leader, civic paternalism with progressive taxation, cultural nationalism and a non-interventionist foreign policy. It rejects laissez-faire liberal capitalism and communization.",
        "s": "dirigisme:0.8|social_corporatism:0.7|Progressive_Taxation:0.6|civic_paternalism:0.6|Non_Interventionism:0.7|cultural_nationalism:0.6|laissez_faire:-1|communization:-0.8|productive_democracy:0.5|organic_statism:0.5|state_corporatism:0.5|protectionism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Techno-Fascism": {
        "d": "Fascism that places advanced technology at the center of national strength: transhumanism and reactionary modernism serve the nation under a strong leader, corporatism and ethical statism, cultural nationalism and imperialism, rejecting civil liberalism and representative democracy.",
        "s": "transhumanism:0.8|reactionary_modernism:0.6|corporatism:0.5|ethical_statism:0.7|cultural_nationalism:0.6|Imperialism:0.5|civil_liberalism:-1|representative_democracy:-1|futurism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "National Solidarity": {
        "d": "Third-position nationalism: cultural nationalism seeks national unity above class through yellow socialism, solidarity among producers in place of both capitalism and socialism, under a strong autocratic leader. It rejects laissez-faire, communization and civil liberalism.",
        "s": "yellow_socialism:0.7|autocracy:0.6|cultural_nationalism:0.7|laissez_faire:-0.9|communization:-0.9|civil_liberalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Clerical Fascism": {
        "d": "Fascism fused with religious authority. The church's doctrine is the moral and legal basis of the state (religious traditionalism and religious authoritarianism), the nation is defined by its religion (religious nationalism), economic life is organized into corporatist bodies of employers and workers under state direction, and power is held by a single leader and party. It scorns parliamentary party politics, liberal freedoms, class-struggle communism and unrestrained markets, and gives clergy and religious institutions a privileged place in education and public life. It is a general form that can arise within any church or nation.",
        "s": "corporatism:0.9|religious_traditionalism:1|religious_authoritarianism:0.9|religious_nationalism:0.9|laissez_faire:-0.7|civil_liberalism:-1|representative_democracy:-1|communization:-1|dirigisme:0.4|amoralism:-0.7|secular_humanism:-0.8|organic_statism:0.5|state_corporatism:0.7|protectionism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Rexism": {
        "d": "Belgian Catholic corporatism: corporatism of cooperating professional bodies under the Church's social doctrine, religious traditionalism and religious nationalism, religious authoritarianism in a strong, authoritative government headed by a leader, armed neutrality abroad, and a moral and spiritual renewal of public life under the kingship of Christ. It replaces parliamentary party politics and secular liberal freedoms, and opposes the class struggle of communism.",
        "s": "corporatism:1|religious_traditionalism:0.9|religious_authoritarianism:0.6|religious_nationalism:0.6|armed_neutrality:0.5|representative_democracy:-1|civil_liberalism:-0.9|communization:-1|amoralism:-0.7|secular_humanism:-0.8|organic_statism:0.5|state_corporatism:0.6|protectionism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Ba'athism": {
        "d": "Arab nationalism and socialism under one vanguard party, summed up as unity, freedom and socialism. It is pan-nationalist: the Arab nation is one people whose states belong in a single Arab state. In a partocracy, a single ruling party guides the state and society as leader of the national resurrection. Economically it favors state socialism, with land reform and public ownership of key industries, and rejects laissez-faire. It is secular and modernizing, and defines freedom first as national liberation from foreign domination.",
        "s": "pan_nationalism:1|state_socialism:0.6|partocracy:0.8|laissez_faire:-0.8|theocracy:-0.7|progressivism:0.4|Imperialism:-0.4|state_enterprise_revenue:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cosmist Vanguardism": {
        "d": "Inspired by Russian cosmism: humanity's common task is to overcome death and spread intelligence through the universe. Extropian and transhumanist, it seeks to enhance the human condition, end ageing and expand intelligence without limit; Promethean, it seeks mastery of technology and nature, and a vanguard organizes research, resources and space exploration for all.",
        "s": "extropianism:0.8|transhumanism:0.7|prometheanism:0.6|technocracy:0.4|collective_distribution:0.4|Cosmopolitanism:0.3|futurism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Duginism": {
        "d": "Fourth Political Theory and neo-Eurasianism: civilizationism holds that civilizations are the actors of history; it opposes globalism, cosmopolitanism, internationalism, civil liberalism and laissez-faire, upholds perennial traditionalism, and pursues imperialism in the form of a Russian-led Eurasian empire in a multipolar order.",
        "s": "civilizationism:1|perennial_traditionalism:0.8|Imperialism:0.7|Globalism:-1|Cosmopolitanism:-1|civil_liberalism:-1|laissez_faire:-0.9|Internationalism:-0.7|pacifism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Fiumanism": {
        "d": "Based on the Carta del Carnaro: social corporatism, in which the people are organized into corporations of producers with cooperation between classes and a further corporation for the nation's cultural and spiritual life; romantic nationalism of heroism, art and national feeling; and an autocratic commander with emergency powers, within a regime of broad civil rights and universal suffrage.",
        "s": "social_corporatism:0.8|romantic_nationalism:0.8|autocracy:0.4|corporatism:0.7|civil_liberalism:0.4|representative_democracy:0.3|organic_statism:0.4|protectionism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Pekerism": {
        "d": "A strict statist and nationalist doctrine of the Turkish republic: dirigisme, in which the state leads the economy and industrial development directly (industrialism), and hypercentralism, in which a strong, uniform central authority and national unity come before individual liberty and class or party interests, with the single ruling party fused with the state. It is solidarist and corporatist, treating society as one body of occupational groups serving the nation, and radically secular and modernizing in its use of state power over education, culture and the economy.",
        "s": "industrialism:0.6|dirigisme:0.5|hypercentralism:0.4|partocracy:0.8|corporatism:0.6|theocracy:-0.8|civil_liberalism:-0.6|laissez_faire:-0.6|progressivism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Ethnonationalist Kemalism": {
        "d": "A Turkish nationalist reading of Kemalism: ethnic nationalism defines the nation by Turkish ethnicity, within a secular state that rejects theocracy and religious authoritarianism. It favors centralism, industrialism and dirigisme in the form of state-led industrialization, a strong security apparatus (securitism), and rejects cosmopolitanism.",
        "s": "ethnic_nationalism:1|centralism:0.8|industrialism:0.6|dirigisme:0.6|securitism:0.5|theocracy:-1|religious_authoritarianism:-0.8|Cosmopolitanism:-1|multiculturalism:-0.8|patchwork:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Eneasism": {
        "d": "Brazilian nationalist program associated with Enéas Carneiro: cultural nationalism that defends national identity and traditional moral order (disciplinarianism), industrialism and dirigisme in the form of state-led industrial development with military and nuclear strength, and an armed neutrality that protects national sovereignty. It rejects globalism and laissez-faire.",
        "s": "cultural_nationalism:0.8|industrialism:0.7|dirigisme:0.6|armed_neutrality:0.5|disciplinarianism:0.4|Globalism:-1|laissez_faire:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Social Nationalism": {
        "d": "Nationalism combined with social welfare: cultural nationalism and traditional values, a social market economy and progressive taxation to protect workers and the national community, rejection of cosmopolitanism and laissez-faire.",
        "s": "cultural_nationalism:0.7|social_market:0.7|Progressive_Taxation:0.6|Cosmopolitanism:-0.8|laissez_faire:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Ethnocacerismo": {
        "d": "Peruvian doctrine holding that the Andean Quechua and Aymara peoples are the true Peruvian nation (ethnic and racial nationalism), to be led by military reservists (stratocracy) in a regimented order. The economy is collectivist, with state-planned collective distribution and agrarian socialism built on communal land, and it rejects laissez-faire and globalism.",
        "s": "ethnic_nationalism:1|stratocracy:0.8|collective_distribution:0.6|agrarian_socialism:0.5|regimentalism:0.5|racial_nationalism:0.6|laissez_faire:-0.9|Globalism:-0.8|communalism:0.4|pacifism:-0.8|multiculturalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Primitivism": {
        "d": "Rejects industrial civilization and modernity in favor of a return to rural, tribal-style life organized around the ethnic nation: primitivism, tribalism and ethnic nationalism, with rejection of industrialism, globalism and cosmopolitanism.",
        "s": "primitivism:1|ethnic_nationalism:0.8|Tribalism:0.7|industrialism:-1|Globalism:-1|Cosmopolitanism:-1|multiculturalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Social-Bonapartism": {
        "d": "Leader-centered populism: an autocratic head of state backed by the people through plebiscites (referendum democracy) uses a centralist state, dirigisme, industrialism and civic paternalism of social programs to unite classes and extend national power (imperialism).",
        "s": "autocracy:1|referendum_democracy:0.4|dirigisme:0.7|industrialism:0.7|civic_paternalism:0.6|centralism:0.8|Imperialism:0.5|patchwork:-0.7|panarchy:-0.5|state_corporatism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Tridemism": {
        "d": "Doctrine of the Three Principles of the People: nationalism, democracy and people's livelihood. Democracy includes a meritocracy in which an examination branch recruits officials by merit and a control branch audits them, and livelihood means a state-guided economy (dirigisme) that equalizes land rights through a land value tax and gives the people civic paternalism of public support for material welfare.",
        "s": "meritocracy:0.7|lvt:0.6|dirigisme:0.5|civic_paternalism:0.5|representative_democracy:0.5|civic_nationalism:0.5|ochlocracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Nationalist Kemalism": {
        "d": "A strongly statist, ethno-cultural reading of Kemalism that puts Turkish national identity first: dirigisme and corporatism, partocracy and ethical statism, cultural and ethnic nationalism, reactionary modernism, discipline and centralism. It rejects theocracy, federalism, regionalism and cosmopolitanism.",
        "s": "dirigisme:0.7|corporatism:0.6|state_capitalism:0.4|conservatism:0.5|reactionary_modernism:0.6|partocracy:0.8|ethical_statism:0.7|cultural_nationalism:0.8|ethnic_nationalism:0.6|Realpolitik:0.6|Isolationism:0.5|industrialism:0.7|disciplinarianism:0.6|regimentalism:0.5|centralism:1|theocracy:-1|federalism:-0.8|regionalism:-0.8|Cosmopolitanism:-0.8|civil_libertarianism:-0.5|state_corporatism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Collectivism": {
        "d": "A totalitarian doctrine that joins state socialism with radical ethnic nationalism: full nationalization of industry, collective distribution, ethical statism, ethnic nationalism, reactionary modernism and isolationism, with totalism and hypercentralism over private life. It rejects laissez-faire, cosmopolitanism and civil libertarianism.",
        "s": "state_socialism:1|collective_distribution:0.9|ethical_statism:0.9|ethnic_nationalism:0.9|reactionary_modernism:0.6|Isolationism:0.7|instrumentalism:0.6|industrialism:0.6|totalism:0.9|hypercentralism:0.7|centralism:0.5|laissez_faire:-1|Cosmopolitanism:-1|Globalism:-0.9|civil_libertarianism:-1|permissivism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Nazi-Maoism": {
        "d": "A syncretic extremist doctrine that combines racial nationalism with Maoist agrarian socialism and guerrilla struggle: agrarian socialism, collective distribution, autocracy and ethical statism, racial nationalism, alter-globalist solidarity with anti-imperialist movements, totalism and regimentalism. It rejects laissez-faire, civil liberalism and representative democracy.",
        "s": "agrarian_socialism:0.9|collective_distribution:0.8|reactionary_modernism:0.5|autocracy:0.8|ethical_statism:0.7|racial_nationalism:1|alter_globalism:0.7|instrumentalism:0.6|industrialism:0.5|totalism:0.7|regimentalism:0.6|centralism:0.6|laissez_faire:-1|civil_liberalism:-1|representative_democracy:-1|multiculturalism:-0.9|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Savinkovism": {
        "d": "A national-populist doctrine of romantic national rebirth under a single strong leader: dirigisme and corporatism, progressive taxation, reactionary modernism, autocracy, romantic nationalism, imperialism and irredentism, industrialism, regimentalism and centralism. It rejects civil libertarianism, representative democracy and internationalism.",
        "s": "dirigisme:0.7|corporatism:0.7|Progressive_Taxation:0.5|reactionary_modernism:0.7|autocracy:0.9|romantic_nationalism:0.9|Imperialism:0.8|irredentism:0.8|industrialism:0.6|regimentalism:0.9|centralism:0.7|civil_libertarianism:-0.9|representative_democracy:-0.8|Internationalism:-0.8|pacifism:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Mosleyism": {
        "d": "The British fascism of Oswald Mosley: an occupational corporatist directorate replacing party politics, with state-led industrialization and imperial autarky. It holds corporatism, syndicracy, ethical statism, reactionary modernism, civilizationism, imperialism, mercantilism, industrialism, regimentalism and centralism, and rejects representative democracy, laissez-faire and civil libertarianism.",
        "s": "corporatism:1|syndicracy:0.6|ethical_statism:0.9|reactionary_modernism:0.8|civilizationism:0.8|Imperialism:0.7|mercantilism:0.8|industrialism:0.8|regimentalism:0.8|centralism:0.8|representative_democracy:-1|laissez_faire:-0.9|civil_libertarianism:-0.9|Cosmopolitanism:-0.7|pacifism:-0.7|productive_democracy:0.4|organic_statism:0.5|state_corporatism:0.5|protectionism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Revolutionary Nationalism": {
        "d": "An anti-imperialist current that joins national liberation with worker-controlled socialism: syndicalism and guild socialism, collective distribution, alternative modernism, syndicracy and councilism, pan-nationalism, alter-globalism, subsidiarity and municipalism. It rejects corporate globalization, bureaucratic centralism and laissez-faire capitalism.",
        "s": "syndicalism:0.7|guild_socialism:0.6|market_socialism:0.4|collective_distribution:0.6|alternative_modernism:0.8|syndicracy:0.8|councilism:0.6|pan_nationalism:0.7|alter_globalism:0.8|irredentism:0.4|subsidiarity:0.6|municipalism:0.5|laissez_faire:-1|Globalism:-0.9|hypercentralism:-0.8|centralism:-0.6|productive_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Volkism": {
        "d": "Völkisch thought: holds that the nation is a living organic community of blood, soil and shared folk culture, with a rural hierarchical order led by a strong leader.",
        "s": "romantic_nationalism:0.9|ethnic_nationalism:0.7|agrarianism:0.8|autocracy:0.5|reactionaryism:0.6|industrialism:-0.5|Cosmopolitanism:-1|civil_liberalism:-0.8|organic_statism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Optimateism": {
        "d": "Rule by an aristocratic elite, the best (optimates): aristocracy in which a hereditary and propertied class governs through a senate or council, and traditionalist conservatism of ancestral custom and established order. It rejects representative democracy and referendum democracy as rule by the masses.",
        "s": "aristocracy:1|traditionalist_conservatism:0.8|representative_democracy:-0.9|referendum_democracy:-1|regressive_taxation:0.9|ochlocracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Integralism": {
        "d": "Catholic social doctrine: holds that political and economic life should be subordinate to the Church's spiritual authority, with local communities, subsidiarity and a distributist or corporatist economy.",
        "s": "religious_traditionalism:1|religious_authoritarianism:0.8|communitarianism:0.7|regionalism:0.5|distributism:0.5|corporatism:0.5|social_distributism:0.5|civil_liberalism:-1|laissez_faire:-0.8|communization:-1|state_socialism:-0.8|subsidiarity:0.5|amoralism:-0.7|secular_humanism:-0.8|organic_democracy:0.5|organic_statism:0.5|futurism:-0.5|protectionism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Capitalism": {
        "d": "Combines free-market capitalism with nationalism: holds that private enterprise should thrive within a strong nation protected by tariffs and national expansion.",
        "s": "laissez_faire:0.7|tariff_funding:0.8|cultural_nationalism:0.8|Imperialism:0.5|Globalism:-1|Cosmopolitanism:-0.8|state_socialism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Carlism": {
        "d": "Spanish traditionalism summed up as God, Fatherland, King. A Catholic monarchy with hereditary rule, limited by regional charters and a corporatist social order: religious traditionalism and religious nationalism, legal moralism that makes law serve Christian morals, regionalism and confederalism that return power to the regions, absolute monarchy bounded by tradition, corporatism and distributism of widely held property. It rejects civil liberalism, representative democracy, centralism, laissez-faire and communism.",
        "s": "religious_traditionalism:1|absolute:0.5|religious_nationalism:0.7|regionalism:0.8|confederalism:0.5|corporatism:0.5|distributism:0.4|legal_moralism:0.5|civil_liberalism:-1|representative_democracy:-0.9|centralism:-0.9|laissez_faire:-0.8|communization:-1|amoralism:-0.7|secular_humanism:-0.8|organic_democracy:0.6|futurism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Autocratic Monarchism": {
        "d": "Absolute monarchy under an autocrat: the monarch holds supreme, unchecked power over state and government by hereditary right, with no charter, parliament or elections limiting the crown. Rule is personal and autocratic, the king decides, and legitimacy comes from dynasty, tradition and custom in the manner of traditionalist conservatism. Royal power is shared with no assembly.",
        "s": "absolute:1|autocracy:0.8|traditionalist_conservatism:0.4|representative_democracy:-1|constitutional:-1|deliberative_democracy:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Theocratic Distributism": {
        "d": "Religious law governs the state (theocracy), in a religious traditionalism that draws society's morals from faith, and productive property should be widely distributed among families and communities (distributism, communitarianism) rather than concentrated in capital or the state. It rejects laissez-faire and state socialism.",
        "s": "theocracy:1|distributism:1|religious_traditionalism:0.8|communitarianism:0.6|laissez_faire:-0.9|state_socialism:-0.9|amoralism:-0.7|secular_humanism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Reactionary Feudalism": {
        "d": "Seeks to restore a hierarchical order of lords and vassals bound by land-based duties and hereditary nobility: feudalism and aristocracy, with land held in return for service, rank inherited by birth and loyalty that is personal and sworn. Its spirit is reactionaryism, a deliberate rejection of the modern world, representative government, equality and progressivism.",
        "s": "feudalism:1|reactionaryism:0.9|aristocracy:0.9|progressivism:-1|representative_democracy:-1|regressive_taxation:0.9|ochlocracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neo-Absolutism": {
        "d": "Modern absolute monarchy: sovereignty rests with a monarch who governs through a managed state (neoreactionaryism), with absolute monarchy rejecting representative democracy, referendum democracy and progressivism.",
        "s": "absolute:1|neoreactionaryism:0.8|representative_democracy:-1|referendum_democracy:-1|progressivism:-1|futurism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Aristocratic Cameralism": {
        "d": "State administration run on cameralist principles by a hereditary aristocracy. The state is managed as a well-ordered estate by trained officials drawn from the nobility, who administer finances, public lands, state enterprises and population to raise revenue for the crown. It values order, thrift and efficient bureaucracy, defends aristocratic rank and privilege, takes a reactionary view of social change, and leaves administration to hereditary officials without elections or parliamentary control.",
        "s": "cameralism:1|aristocracy:0.9|reactionaryism:0.6|representative_democracy:-0.9|state_capitalism:0.5|constitutional:-0.4|ochlocracy:-0.7|organic_statism:0.4|protectionism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Feudal Monarchism": {
        "d": "A monarch at the top of a feudal hierarchy of nobles bound by land and loyalty: feudalism, with fiefs granted in exchange for military service and counsel, aristocracy, in which lords hold authority over their lands and the people on them, and traditionalist conservatism of custom and rank in an agrarian, manorial order. It rejects representative democracy and progressivism.",
        "s": "feudalism:1|traditionalist_conservatism:0.6|aristocracy:0.7|representative_democracy:-0.9|progressivism:-0.9|suzerainty:0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Clerical Monarchism": {
        "d": "Monarchy sanctified and guided by church authority: the monarch rules as protector of the faith through religious authoritarianism and absolute monarchy, religious traditionalism supplies law and morals, and religious nationalism ties the kingdom's identity to the church. Authority is unelected and bound by doctrine, and popular votes and freedom of conscience have no standing.",
        "s": "religious_authoritarianism:0.9|religious_traditionalism:0.9|religious_nationalism:0.6|absolute:0.5|civil_liberalism:-1|representative_democracy:-0.9|semi_constitutional:0.9|amoralism:-0.7|secular_humanism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Developmental Theocracy": {
        "d": "Religious rule that uses industrial development to strengthen the faith-based nation: theocracy in which religious law and clergy rule, religious nationalism, industrialism with state-led industry and infrastructure, and traditionalist conservatism that preserves custom.",
        "s": "theocracy:1|religious_nationalism:0.8|industrialism:0.7|traditionalist_conservatism:0.6|dirigisme:0.5|religious_traditionalism:0.6|amoralism:-0.7|secular_humanism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Classical Eurasianism": {
        "d": "Holds that Eurasia is a distinct civilization (civilizationism) and geopolitical space with Russia at its core. It favors traditionalist conservatism, a strong state with dirigisme directing the economy, and a realist (Realpolitik) foreign policy that pursues continental power, opposing globalism, the liberal Atlantic order and civil liberalism.",
        "s": "civilizationism:1|traditionalist_conservatism:0.6|Realpolitik:0.6|dirigisme:0.5|Globalism:-0.9|civil_liberalism:-0.6|suzerainty:0.7|organic_statism:0.4|protectionism:0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Mladorossism": {
        "d": "Russian monarchist doctrine of a social monarchy: a Tsar as head of state in an absolute monarchy, a state-directed economy (state socialism), Orthodox religious traditionalism and traditionalist conservatism, regimented national unity and Russian civilizationism. It rejects representative democracy and laissez-faire.",
        "s": "absolute:0.7|state_socialism:0.5|religious_traditionalism:0.5|traditionalist_conservatism:0.4|civilizationism:0.4|regimentalism:0.5|laissez_faire:-0.8|representative_democracy:-0.9|dirigisme:0.6|organic_statism:0.4|protectionism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "National Social Capitalism": {
        "d": "A market economy organized for the benefit of the nation's own people: ethnic nationalism defines the national community, a social market economy with progressive taxation provides welfare to its members, and a strong centralist state coordinates the economy so that capitalism serves national cohesion.",
        "s": "social_market:0.6|Progressive_Taxation:0.5|ethnic_nationalism:0.8|centralism:0.5|dirigisme:0.4|multiculturalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Right-State Liberalism": {
        "d": "Right-wing liberalism with a strong state as guardian of the free market: laissez-faire economics, low flat taxation and little regulation, civil liberalism in civil life, and an autocratic executive that enforces property rights, contracts, competition and order against pressure groups.",
        "s": "laissez_faire:0.8|flat_taxation:0.6|autocracy:0.4|civil_liberalism:0.5|state_enterprise_revenue:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Monarquia Syndicalista": {
        "d": "The Portuguese national-syndicalist doctrine of a social monarchy under a traditional king: syndicalism, religious traditionalism, a constitutional monarchy that keeps real powers, syndicracy, cultural nationalism, non-interventionism, discipline, regionalism and subsidiarity. It rejects laissez-faire capitalism, representative party politics and centralized dictatorship.",
        "s": "syndicalism:0.9|Progressive_Taxation:0.4|religious_traditionalism:0.8|semi_constitutional:0.9|constitutional:0.4|syndicracy:0.8|cultural_nationalism:0.8|Non_Interventionism:0.6|disciplinarianism:0.5|regionalism:0.7|subsidiarity:0.8|laissez_faire:-1|representative_democracy:-0.7|autocracy:-0.7|hypercentralism:-0.8|organic_democracy:0.5|state_corporatism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Serenissimism": {
        "d": "The patrician republicanism of Venice: an hereditary aristocracy bound by oath, guild-regulated cameralist commerce, customs duties in place of direct taxation, mercantilism, communitarianism, legal moralism and suzerainty over maritime dependencies. It rejects egalitarian democracy, communization and laissez-faire.",
        "s": "cameralism:0.8|corporatism:0.5|tariff_funding:0.9|traditionalist_conservatism:0.7|aristocracy:1|oligarchy:1|communitarianism:0.6|mercantilism:0.9|legal_moralism:0.6|suzerainty:0.8|referendum_democracy:-1|communization:-1|laissez_faire:-0.8|Cosmopolitanism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Conservatism": {
        "d": "Holds that national identity, sovereignty and traditional culture should guide policy: cultural nationalism and conservatism, legal moralism, representative democracy, a modest residual welfare state for citizens, and rejection of globalism, cosmopolitanism and international institutions (internationalism).",
        "s": "cultural_nationalism:1|conservatism:0.8|representative_democracy:0.5|legal_moralism:0.5|residualism:0.4|Globalism:-1|Cosmopolitanism:-0.8|Internationalism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Paternalistic Conservatism": {
        "d": "Conservatism holding that the privileged have a duty to care for the less fortunate: paternalistic capitalism and civic paternalism combine social support with conservatism's respect for tradition, hierarchy and cultural nationalism, and progressive taxation. It rejects laissez-faire.",
        "s": "paternalistic_capitalism:0.8|civic_paternalism:0.8|conservatism:0.8|cultural_nationalism:0.5|Progressive_Taxation:0.5|laissez_faire:-0.6|organic_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Buchanan Paleoconservatism": {
        "d": "Economic nationalism with tariff-based funding, traditional Christian cultural values and a non-interventionist foreign policy, as championed by Pat Buchanan: paleoconservatism and cultural nationalism protect national identity and traditional Christian morals (legal moralism) in the culture wars, tariffs defend national workers and industry and fund the government, isolationism avoids foreign wars and entanglements, and a populist outlook rejects globalism and cosmopolitanism.",
        "s": "paleoconservatism:1|cultural_nationalism:0.8|tariff_funding:0.7|Isolationism:0.7|legal_moralism:0.5|Globalism:-1|Interventionism:-0.9|Cosmopolitanism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Hard Right Paleoconservatism": {
        "d": "A harder form of paleoconservatism: traditionalist, cultural nationalist and isolationist, holding that the nation is bound by inherited culture, religion and tradition. It favors legal moralism, rejects globalism, progressivism and foreign interventionism, and defends the nation against mass immigration and egalitarian social change.",
        "s": "paleoconservatism:1|cultural_nationalism:0.8|Isolationism:0.7|legal_moralism:0.5|Globalism:-1|Interventionism:-0.9|progressivism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Old Right Paleoconservatism": {
        "d": "Heir to the American Old Right: paleoconservatism with federalism, limited constitutional government, local self-government and distributism of widespread property ownership, cultural nationalism and legal moralism, and isolationism that rejects foreign interventionism and globalism.",
        "s": "paleoconservatism:1|cultural_nationalism:0.6|Isolationism:0.8|legal_moralism:0.4|federalism:0.6|distributism:0.4|Interventionism:-1|Globalism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neoconservatism": {
        "d": "Supports promoting democracy and national power abroad: interventionism, a strong military and moral clarity, representative democracy and civic nationalism, liberal conservatism with a market economy and limited residual welfare. It rejects isolationism and non-interventionism.",
        "s": "Interventionism:1|civic_nationalism:0.6|representative_democracy:0.7|residualism:0.5|liberal_conservatism:0.5|Isolationism:-1|Non_Interventionism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Mesoconservatism": {
        "d": "A moderate, centrist conservatism: conservatism values traditional institutions, family and community, representative democracy and gradual, cautious reform, a civic nationalism of shared citizenship, and an active interventionist foreign policy that uses alliances to protect national interests and order.",
        "s": "conservatism:0.6|representative_democracy:0.5|Interventionism:0.5|civic_nationalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Red Toryism": {
        "d": "British conservative current that stresses community, tradition and local institutions: traditionalist conservatism and communitarianism, constitutional monarchy and a cultural nationalism of national heritage, a social-distributist spread of property, and paternalistic capitalism in which business owes duties to workers and communities, with refusal of laissez-faire market individualism.",
        "s": "traditionalist_conservatism:0.9|communitarianism:0.8|constitutional:0.6|cultural_nationalism:0.5|social_distributism:0.5|paternalistic_capitalism:0.5|laissez_faire:-0.8|organic_democracy:0.6|futurism:-0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Green Conservatism": {
        "d": "Applies conservative preservation to nature: conservationism and environmentalism hold that people keep the natural world in trust for future generations, and conservatism favors stewardship through property rights, local communities, tradition and slow, organic reform within a social market economy.",
        "s": "conservationism:1|environmentalism:0.8|conservatism:0.7|social_market:0.5|communitarianism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Clerical Conservatism": {
        "d": "Conservatism grounded in religious teaching: religious traditionalism that draws moral order from faith, legal moralism, religious nationalism with the church influential in public life, the traditional family, and paternalistic capitalism that cares for workers within a market economy, all within representative democracy. It rejects permissivism and progressivism.",
        "s": "religious_traditionalism:1|religious_nationalism:0.6|legal_moralism:0.7|representative_democracy:0.4|paternalistic_capitalism:0.4|permissivism:-0.8|progressivism:-0.8|amoralism:-0.7|secular_humanism:-0.8|organic_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Gaullism": {
        "d": "Doctrine of Charles de Gaulle: a strong, independent France led by a powerful president above party politics, with state-guided economic planning and national autonomy in defense and foreign policy.",
        "s": "dirigisme:0.7|centralism:0.6|cultural_nationalism:0.6|armed_neutrality:0.5|civic_paternalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Free-Market Conservatism": {
        "d": "Conservatism that prizes laissez-faire free enterprise, low taxes (it rejects progressive taxation) and limited government alongside national tradition: conservatism, civic nationalism and representative democracy, with firm opposition to state socialism.",
        "s": "laissez_faire:0.9|conservatism:0.6|civic_nationalism:0.5|representative_democracy:0.5|state_socialism:-1|Progressive_Taxation:-0.7|state_enterprise_revenue:-0.7|parecon:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Agrarian Conservatism": {
        "d": "Holds that rural life, small-farm ownership, local community and tradition are the basis of a healthy society.",
        "s": "agrarianism:1|distributism:0.6|conservatism:0.7|communitarianism:0.7|industrialism:-0.5|organic_democracy:0.5|futurism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Liberal Toryism": {
        "d": "A conservative strand with a liberal outlook: progressive conservatism that accepts gradual reform, Keynesianism and state management of the economy, social provision, and a globalist openness to trade and cooperation with the wider world within continuity of institutions and tradition.",
        "s": "progressive_conservatism:0.6|Globalism:0.5|keynesianism:0.4|conservatism:0.5|social_market:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Social Gaullism": {
        "d": "Gaullist doctrine emphasizing worker participation in firms and social reform: yellow socialism and Rhine capitalism of cooperation between labor and capital, civic paternalism and progressive conservatism, progressive taxation, and armed neutrality for national independence.",
        "s": "yellow_socialism:0.7|civic_paternalism:0.5|armed_neutrality:0.5|progressive_conservatism:0.5|rhine_capitalism:0.5|Progressive_Taxation:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Neo-Gaullism": {
        "d": "Contemporary Gaullist doctrine: civic nationalism of national independence, centralism and a strong state with a president as the nation's guide above party politics, liberal conservatism with market-oriented reform, and a Realpolitik foreign policy of national interest and rank in the world.",
        "s": "civic_nationalism:0.5|centralism:0.5|Realpolitik:0.4|liberal_conservatism:0.5|autocracy:0.3|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Bonapartist Gaullism": {
        "d": "Gaullist doctrine built around a strong leader above parties who appeals directly to the people. Autocratic in style, it favors hypercentralism, a strongly centralized state, with dirigisme (state direction of the economy) and industrialism for national grandeur, cultural nationalism that treats the nation's culture as its foundation, and an independent foreign policy of armed neutrality that keeps the nation free of the power blocs.",
        "s": "autocracy:0.6|hypercentralism:0.5|dirigisme:0.6|industrialism:0.6|armed_neutrality:0.5|cultural_nationalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Conservative Atlanticism": {
        "d": "Conservative support for the transatlantic alliance as the foundation of Western security. Civilizationism holds the West is a shared civilization with a common heritage; liberal conservatism combines market economy with the rule of law; representative democracy is defended; and a realist (Realpolitik), cautious foreign policy rests on alliances, deterrence and stability.",
        "s": "civilizationism:0.8|Realpolitik:0.5|liberal_conservatism:0.6|representative_democracy:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neoconservative Atlanticism": {
        "d": "Neoconservative thought joined to Atlanticist alliance policy: interventionism uses the Western alliance's military and political power to defend Western civilization (civilizationism) and to secure or spread democracy and liberal values, with a strong defense establishment and firm security measures (securitism) at home and liberal-conservative economics.",
        "s": "Interventionism:1|civilizationism:0.8|securitism:0.6|liberal_conservatism:0.4|representative_democracy:0.6|civil_liberalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "One-Nation Conservatism": {
        "d": "Tory doctrine that society is an organic whole in which the privileged owe duties to the less fortunate: civic paternalism, progressive conservatism and gradual reform, a mixed economy with Keynesianism and progressive taxation, cultural nationalism, and rejection of laissez-faire and of communization.",
        "s": "civic_paternalism:0.8|progressive_conservatism:0.7|cultural_nationalism:0.4|Progressive_Taxation:0.5|keynesianism:0.4|laissez_faire:-0.6|communization:-1|organic_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Conservative Kemalism": {
        "d": "Right-leaning Kemalism: a secular republic that rejects theocracy, with centralism of a unitary state under one authority, cultural nationalism resting on national culture, tradition and family, and conservatism that favors moral order and gradual change.",
        "s": "centralism:0.6|cultural_nationalism:0.7|conservatism:0.6|theocracy:-0.8|legal_moralism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Conservative Technoliberalism": {
        "d": "Market-friendly liberal conservatism that embraces technology: post-industrialism built on knowledge, services and digital industry, a globalist outlook with open trade, civil libertarian protection of privacy, federalism that disperses political power, and conservative institutions and gradual change.",
        "s": "post_industrialism:0.8|Globalism:0.6|civil_libertarianism:0.5|liberal_conservatism:0.5|federalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Right-Social Authoritarianism": {
        "d": "Authoritarian rule from the right: autocracy, in which one strong ruler or executive holds power that is not subject to popular control; securitism, in which public safety and security, with surveillance and policing, come before individual privacy; and centralism, a unitary state in which national authority is concentrated. Its outlook is conservative and hierarchical, valuing order, obedience and traditional social order, and welfare, jobs and public services are offered as part of that order to secure loyalty and cohesion. Its guiding aim is order and the preservation of hierarchy.",
        "s": "securitism:0.6|centralism:0.5|autocracy:0.5|conservatism:0.6|civic_paternalism:0.5|traditionalist_conservatism:0.4|civil_libertarianism:-0.5|state_corporatism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Kjærsgaardism": {
        "d": "Danish national-conservative politics: cultural nationalism that protects Danish culture and sovereignty, isolationism with strict limits on immigration, rejection of cosmopolitanism and globalism, a welfare state for Danes financed by progressive taxation, and legal moralism that favors firm law and order.",
        "s": "cultural_nationalism:0.9|Isolationism:0.4|Progressive_Taxation:0.4|legal_moralism:0.4|Cosmopolitanism:-1|Globalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Kekkonism": {
        "d": "Finnish doctrine of armed neutrality and careful, trust-based relations with a powerful neighbor, with a strong centralist presidency directing foreign policy above party politics. At home it combines state-guided industrialism with neocorporatism, bargaining among employers, unions and agriculture under state coordination, and puts stability and consensus first.",
        "s": "armed_neutrality:0.8|neo_corporatism:0.6|industrialism:0.5|centralism:0.5|dirigisme:0.5|autocracy:0.3|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Reform Gaullism": {
        "d": "Gaullist doctrine joined to social and economic reform: neocorporatism and a Rhine capitalism that bring workers into the life of the enterprise through profit-sharing, participation and cooperation among employers, unions and the state; progressive conservatism and civic paternalism; and industrialism and armed neutrality for national independence from the power blocs.",
        "s": "neo_corporatism:0.5|progressive_conservatism:0.5|armed_neutrality:0.4|industrialism:0.4|civic_paternalism:0.4|rhine_capitalism:0.4|yellow_socialism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Paleoconservatism": {
        "d": "A traditionalist, nationalist conservatism of the American Old Right: paleoconservatism and cultural nationalism, tariffs and flat taxation, distributism and small enterprise, representative democracy, legal moralism and isolationism. It rejects interventionism, globalism and cosmopolitanism.",
        "s": "paleoconservatism:1|cultural_nationalism:0.9|distributism:0.5|free_market_distributism:0.4|tariff_funding:0.6|flat_taxation:0.4|representative_democracy:0.6|legal_moralism:0.7|Isolationism:0.8|federalism:0.5|Interventionism:-1|Globalism:-1|Cosmopolitanism:-0.9|multiculturalism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Putinism": {
        "d": "The political economy of the Russian Federation under Putin: a super-presidential autocracy and oligarchic rule, state capitalism and corporatocracy, a flat tax, traditionalist conservatism, civilizationism, imperialism with irredentism, securitism and a managed center. It rejects cosmopolitanism and civil libertarianism.",
        "s": "state_capitalism:0.8|corporatocracy:0.7|dirigisme:0.5|flat_taxation:0.9|conservatism:0.7|traditionalist_conservatism:0.6|autocracy:0.9|oligarchy:0.7|civilizationism:0.9|Imperialism:0.6|Realpolitik:0.7|irredentism:0.6|industrialism:0.5|instrumentalism:0.6|securitism:0.9|centralism:0.7|regionalism:0.3|Cosmopolitanism:-0.8|civil_libertarianism:-0.8|representative_democracy:-0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Post-Soviet Autocracy": {
        "d": "The governance model of several post-1991 republics: a super-presidential executive and oligarchic ties, state-capitalist ownership of key industries, corporatocracy, a flat or lightly progressive tax, conservatism, civic nationalism, multi-vector realism, securitism and centralism. It rejects federalism and civil libertarianism.",
        "s": "state_capitalism:0.9|corporatocracy:0.6|flat_taxation:0.6|Progressive_Taxation:0.3|conservatism:0.7|autocracy:0.9|oligarchy:0.9|civic_nationalism:0.7|Realpolitik:0.9|industrialism:0.6|securitism:0.9|centralism:0.9|civil_libertarianism:-0.8|federalism:-0.7|referendum_democracy:-0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Radicalism": {
        "d": "Historic liberal-republican current: secular and anti-clerical, rejecting theocracy, religious authoritarianism and absolute monarchy, with civil liberalism, representative democracy, civic nationalism of patriotic citizenship, internationalism and a social solidarity economy.",
        "s": "civil_liberalism:0.8|representative_democracy:0.7|civic_nationalism:0.6|Internationalism:0.5|social_solidarity_economy:0.4|theocracy:-1|religious_authoritarianism:-0.9|absolute:-1|secular_humanism:0.8|demarchy:0.5|deliberative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Third Way": {
        "d": "Centrist approach combining a market economy with social-democratic goals: the third way of modernization and public-private partnership, a post-industrial economy, civil liberalism and representative democracy, globalism and progressive taxation.",
        "s": "third_way:1|post_industrialism:0.6|civil_liberalism:0.6|representative_democracy:0.6|Globalism:0.5|Progressive_Taxation:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Christian Democracy": {
        "d": "Politics based on Christian social ethics: a social market economy that joins competition with solidarity, representative democracy, religious traditionalism grounded in family and faith, internationalism through European integration, and progressive taxation that finances social solidarity, subsidiarity and care for the family and the weak.",
        "s": "social_market:0.8|representative_democracy:0.8|religious_traditionalism:0.5|Internationalism:0.5|Progressive_Taxation:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Compassionate Conservatism": {
        "d": "Conservatism that uses conservative principles to help the poor. Through civic paternalism and conservatism, it holds that personal responsibility, family, work and faith are the foundations of a good society, with religious traditionalism, and that the state should support faith-based and charitable organizations and offer targeted help in a residual safety net that encourages self-reliance.",
        "s": "civic_paternalism:0.7|conservatism:0.5|residualism:0.4|religious_traditionalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Rockefeller Republicanism": {
        "d": "Moderate Republicanism: liberal conservatism of fiscal prudence combined with a social market economy, Keynesianism, social programs and civil rights, representative democracy and an active internationalism.",
        "s": "liberal_conservatism:0.8|keynesianism:0.4|Internationalism:0.5|representative_democracy:0.6|social_market:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Democratic Transhumanism": {
        "d": "Holds that technology should enhance human capacities within a democratic framework, with guaranteed access for all, including a basic income, and global cooperation.",
        "s": "transhumanism:1|basic_income_capitalism:0.5|representative_democracy:0.6|progressivism:0.6|Globalism:0.6|Cosmopolitanism:0.7|futurism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neo-Solidarism": {
        "d": "Builds on the solidarity economy: cooperative and social enterprise, progressive social values, ecological modernization and internationalism.",
        "s": "social_solidarity_economy:1|social_progressivism:0.6|ecomodernism:0.5|environmentalism:0.5|Internationalism:0.6|representative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Steppe Eurasianism": {
        "d": "A form of Eurasianism that stresses a distinct civilization built around the steppe. It holds that the vast Eurasian continent forms a unified geographical and cultural world, neither purely European nor Asian, whose common character was shaped by the interaction of steppe peoples such as the Turkic and Mongol with their settled neighbors; that this civilization has its own values rooted in tradition, community and strong authority; and that it should keep apart from Western liberal universalism and from dependence on Atlantic powers, pursuing continental cooperation and unity instead.",
        "s": "civilizationism:0.8|traditionalist_conservatism:0.4|communitarianism:0.4|Globalism:-0.5|civil_liberalism:-0.4|state_enterprise_revenue:0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Classical Kemalism": {
        "d": "Atatürk's doctrine of republicanism, nationalism, populism, statism, secularism and reform: a secular civic nation that rejects theocracy, religious authority and monarchy, dirigisme with state-led industrialization, and progressivism that modernizes law, education and society from above.",
        "s": "dirigisme:0.8|civic_nationalism:0.8|progressivism:0.6|industrialism:0.6|theocracy:-1|religious_authoritarianism:-0.9|absolute:-1|secular_humanism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Centrist Kemalism": {
        "d": "Moderate Kemalism: a secular republic that rejects theocracy and keeps religion out of government. It is built on civic nationalism, equal citizenship in one Turkish nation, centralism of a unitary state and dirigisme, state-supported planning and development, interpreted pragmatically within a democratic, multi-party framework that seeks balance and consensus.",
        "s": "civic_nationalism:0.6|dirigisme:0.4|centralism:0.5|theocracy:-0.9|representative_democracy:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Catholic Social Teaching": {
        "d": "The Church's social doctrine: human dignity, the common good, solidarity, subsidiarity, workers' rights, private property with a social purpose and care for creation.",
        "s": "communitarianism:0.8|civic_paternalism:0.5|Internationalism:0.5|conservationism:0.5|environmentalism:0.6|laissez_faire:-0.9|communization:-1|state_socialism:-0.8|subsidiarity:0.4|organic_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Bleeding-Heart Authoritarianism": {
        "d": "Authoritarian rule justified by compassion. An autocratic, centralist state holds power and uses it to impose progressivism and a permissive social order with wide personal freedom in private life, within a globalist outlook open to the world economy. The ruler claims a duty to care for the people's welfare and to make society more equal and tolerant, and treats strong centralized authority as the instrument of kindness.",
        "s": "autocracy:0.6|centralism:0.5|permissivism:0.5|progressivism:0.5|Globalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Austro-Corporatism": {
        "d": "Austrian model of corporatism: the economy and society are organized through occupational chambers in which employers, workers and professions are represented as estates, and through neocorporatist social partnership among employers, unions and the state. It has Catholic social roots, a federal state of provinces, an Austrian national culture and a policy of armed neutrality.",
        "s": "neo_corporatism:0.9|corporatism:0.4|armed_neutrality:0.5|federalism:0.4|cultural_nationalism:0.4|organic_democracy:0.6|organic_statism:0.5|state_corporatism:0.6|protectionism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Davos System": {
        "d": "The technocratic global governance model of stakeholder capitalism: Rhine capitalism and the third way, mixed land taxation and progressive taxation, progressivism and civil liberalism, technocracy, cosmopolitanism and globalism, post-industrialism and ecomodernism, civic paternalism and federalism. It rejects isolationism, ethnic nationalism and laissez-faire.",
        "s": "rhine_capitalism:0.8|third_way:0.8|mixed_lvt:0.4|Progressive_Taxation:0.5|progressivism:0.8|civil_liberalism:0.6|technocracy:1|Cosmopolitanism:0.8|Globalism:1|post_industrialism:0.7|ecomodernism:0.8|civic_paternalism:0.7|federalism:0.7|Isolationism:-1|ethnic_nationalism:-1|racial_nationalism:-1|laissez_faire:-0.5|anarchism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Nordic Model": {
        "d": "A universal welfare state financed by progressive taxation: neocorporatism and bargaining among unions, employers and the state, civic paternalism in public services provided to all, Rhine capitalism's stakeholder economy, social-progressive gender equality, representative democracy and an open, internationalist economy with high social trust.",
        "s": "neo_corporatism:0.8|Progressive_Taxation:0.8|civic_paternalism:0.6|social_progressivism:0.6|rhine_capitalism:0.6|Internationalism:0.5|representative_democracy:0.6|ghent_system:0.8|regressive_taxation:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Social Democracy": {
        "d": "Pursues a fairer society by democratic means: a regulated market economy, a welfare state, progressive taxation, labor rights and international cooperation. It holds that capitalism should be reformed, not abolished: markets are kept but regulated and balanced by strong public services, social insurance, collective bargaining and active economic management, including Keynesian demand policy, to secure equal opportunity and security. It works through elections and representative democracy, supports social progress and international solidarity, and rejects both laissez-faire and revolutionary communism. Its aims are broad, joining employment, equality, public services and democratic participation.",
        "s": "social_market:0.7|Progressive_Taxation:0.8|representative_democracy:0.8|social_progressivism:0.6|civic_paternalism:0.6|Internationalism:0.5|keynesianism:0.5|laissez_faire:-0.8|communization:-0.7|ghent_system:0.4|regressive_taxation:-0.8|deliberative_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Conservative Social Democracy": {
        "d": "Social-democratic politics that keeps the conservative values of family, nation and tradition while supporting a social market economy, progressive taxation, communitarianism and representative democracy.",
        "s": "conservatism:0.6|communitarianism:0.6|social_market:0.5|Progressive_Taxation:0.6|representative_democracy:0.5|ghent_system:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Social Distributism": {
        "d": "Holds that productive property should be widely distributed through cooperatives and local ownership (social-distributist ownership): communitarian subsidiarity, progressive taxation, an alter-globalist international order, and rejection of both laissez-faire capitalism and state socialism.",
        "s": "social_distributism:1|communitarianism:0.7|Progressive_Taxation:0.5|alter_globalism:0.5|laissez_faire:-0.8|state_socialism:-0.6|distributism:0.6|organic_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Eurocommunism": {
        "d": "West European communism that accepts representative democracy and civil liberalism: multiparty elections and civil liberties, no monopoly for a ruling party (it rejects partocracy), progressive taxation and welfare, internationalism and independence from any foreign center, with socialism pursued through democratic means.",
        "s": "representative_democracy:0.8|civil_liberalism:0.5|Internationalism:0.4|Progressive_Taxation:0.5|partocracy:-0.7|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Liberal Socialism": {
        "d": "Joins individual liberty with socialist goals: market socialism, civil liberalism, representative democracy and progressive taxation, pursued through democratic means, rejecting totalism and one-party rule (partocracy).",
        "s": "market_socialism:0.8|civil_liberalism:0.8|representative_democracy:0.7|Progressive_Taxation:0.5|partocracy:-0.8|totalism:-1|state_enterprise_revenue:0.5|deliberative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Social Georgism": {
        "d": "Georgism joined to social reform: land value tax as the main public revenue (with mixed land tax as a variant), shared land rent funding social reform in a social market economy, social-progressive aims and representative democracy, on the view that land and natural resources belong equally to all.",
        "s": "lvt:1|mixed_lvt:0.6|social_market:0.5|social_progressivism:0.5|representative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Agrarian Social Democracy": {
        "d": "Social-democratic politics built on agrarianism: the land and the communities that work it are the foundation of a just society. It pursues rural welfare through representative democracy, progressive taxation, public services and cooperatives, and favors social-distributist ownership in which land and productive property are widely spread among farming families and cooperatives. Communitarian in spirit, it prizes village and community life, mutual aid, land stewardship and secure tenure for those who farm.",
        "s": "agrarianism:0.9|communitarianism:0.7|social_distributism:0.5|Progressive_Taxation:0.5|representative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Progressive Corporatism": {
        "d": "Corporatism within a democracy: neocorporatism, in which unions, employers and the state negotiate policy together in standing representative bodies through co-determination, works councils and social partnership, a Rhine capitalism of stakeholder firms, progressive taxation and representative democracy, with social-progressive values and an internationalist outlook.",
        "s": "neo_corporatism:0.9|rhine_capitalism:0.8|social_progressivism:0.6|Progressive_Taxation:0.5|Internationalism:0.4|representative_democracy:0.6|corporatism:0.6|ghent_system:0.5|organic_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Left-Gaullism": {
        "d": "Gaullist national independence and state economic planning joined to a progressive agenda: dirigisme, armed neutrality that keeps the nation free of the blocs, civic nationalism, progressive taxation, social-progressive reform and a social solidarity economy of cooperatives and non-profits.",
        "s": "dirigisme:0.6|armed_neutrality:0.5|civic_nationalism:0.5|Progressive_Taxation:0.5|social_progressivism:0.5|social_solidarity_economy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Labour Atlanticism": {
        "d": "Social-democratic support for the Atlantic alliance: civilizationism treats the Western democratic bloc as a shared civilization, with representative democracy, Keynesianism, progressive taxation, a welfare state, social-progressive reform and internationalism through alliances.",
        "s": "keynesianism:0.5|Progressive_Taxation:0.6|social_progressivism:0.5|representative_democracy:0.6|civilizationism:0.5|Internationalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Green Social Democracy": {
        "d": "Social-democratic politics built around environmental sustainability: environmentalism as the organizing principle, progressive taxation, a social market economy, representative democracy, civic paternalism that protects workers and communities in the transition, social-progressive reform and internationalism through climate agreements.",
        "s": "environmentalism:1|social_market:0.6|Progressive_Taxation:0.7|civic_paternalism:0.5|social_progressivism:0.5|representative_democracy:0.6|Internationalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Geo-Social Democracy": {
        "d": "Social democracy financed by land value taxation, with welfare, public services and social progress. Its central commitment is the social-democratic one: a welfare state and public services run through democratic institutions, with a paternal concern for citizens' security and equal opportunity. Land value tax, and mixed land taxation, is adopted as the preferred means of paying for it, alongside other taxes, because it taxes unearned rent rather than work. The welfare state is its goal, and land value taxation is the instrument that pays for it.",
        "s": "lvt:0.8|mixed_lvt:0.6|civic_paternalism:0.5|social_progressivism:0.5|representative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Christian Social Democracy": {
        "d": "Social-democratic politics grounded in Christian ethics of solidarity: communitarianism, civic paternalism that cares for the vulnerable, progressive taxation, representative democracy, a social solidarity economy of cooperatives and non-profits alongside private enterprise, environmentalism as stewardship of creation, internationalism and religious traditionalism.",
        "s": "communitarianism:0.6|civic_paternalism:0.6|Progressive_Taxation:0.6|social_solidarity_economy:0.5|environmentalism:0.4|representative_democracy:0.6|Internationalism:0.4|religious_traditionalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Police Labourism": {
        "d": "Labor-welfare politics combined with a strong emphasis on policing and law and order: securitism holds that workers' security depends on safe streets and a well-funded police and criminal justice system, while progressive taxation and social corporatism, cooperation among labor, employers and the state, deliver unions, social provision and protection as a public service owed to working people.",
        "s": "securitism:0.7|Progressive_Taxation:0.4|social_corporatism:0.4|civic_paternalism:0.5|retributivism:0.7|reputationalism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Ecevitism": {
        "d": "The democratic left of Bülent Ecevit: secular, rejecting theocracy, with civic nationalism, social-progressive reform, progressive taxation, a social market economy and industrialism backed by the state.",
        "s": "Progressive_Taxation:0.5|social_progressivism:0.5|civic_nationalism:0.5|social_market:0.4|industrialism:0.4|theocracy:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Left-Social Authoritarianism": {
        "d": "Authoritarian leadership combined with left-wing economic policy: autocracy, in which one leader holds absolute power that is not subject to popular control, with centralism, a unitary state in which national authority is concentrated; civic paternalism, in which the state guides, regulates and safeguards public health and the people's wellbeing; and progressive taxation, a tax rate that rises with income and finances welfare and state-led development, all defined by egalitarian economics.",
        "s": "autocracy:0.6|Progressive_Taxation:0.6|centralism:0.5|civic_paternalism:0.5|dirigisme:0.5|state_enterprise_revenue:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Progressive Social Authoritarianism": {
        "d": "An authoritarian state that promotes social progress and modernization. A strong, centralized government uses its power to push society forward through state-led development, industrial growth, education, public health and progressive taxation, and to override tradition, social conservatism and resistance to reform. Progress is treated as a task of the state rather than the product of free debate or spontaneous change. Its distinctive aim is to remake society along progressive lines.",
        "s": "autocracy:0.6|progressivism:0.6|centralism:0.5|Progressive_Taxation:0.5|industrialism:0.4|dirigisme:0.5|conservatism:-0.6|state_enterprise_revenue:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Left-Wing Populism": {
        "d": "Pits ordinary people against elites: redistribution, direct popular participation, social rights and opposition to corporate globalization.",
        "s": "referendum_democracy:0.5|Confiscatory_Taxation:0.5|alter_globalism:0.7|social_progressivism:0.5|civil_libertarianism:0.4|laissez_faire:-0.9|Globalism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Left-Social Democracy": {
        "d": "The left of social-democratic politics: representative democracy with stronger redistribution through confiscatory taxation, market socialism and worker power, communitarianism, civic paternalism, social-progressive reform and an alter-globalist stance toward corporate globalization.",
        "s": "market_socialism:0.6|Confiscatory_Taxation:0.5|social_progressivism:0.6|representative_democracy:0.7|communitarianism:0.5|alter_globalism:0.5|civic_paternalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Social-Helveticism": {
        "d": "Swiss-style social-democratic politics: referendum democracy, federalism, armed neutrality, civic nationalism, and a welfare state of civic paternalism financed by progressive taxation, with social-progressive reform.",
        "s": "referendum_democracy:0.8|federalism:0.8|armed_neutrality:0.8|civic_paternalism:0.5|Progressive_Taxation:0.4|social_progressivism:0.4|civic_nationalism:0.5|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Left Kemalism": {
        "d": "The social-democratic evolution of Kemalism: state socialism and market socialism, confiscatory taxation of great wealth, social progressivism, representative democracy, civic nationalism, armed neutrality, industrialism, civic paternalism and centralism. It rejects laissez-faire, theocracy and ethnic nationalism.",
        "s": "state_socialism:0.6|market_socialism:0.6|state_enterprise_revenue:0.5|Confiscatory_Taxation:0.5|social_progressivism:0.9|representative_democracy:0.9|civic_nationalism:0.9|armed_neutrality:0.7|industrialism:0.7|civic_paternalism:0.7|centralism:0.8|laissez_faire:-1|theocracy:-1|ethnic_nationalism:-0.8|religious_nationalism:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Longism": {
        "d": "The populist 'Share Our Wealth' program of Huey Long: Keynesian public works, paternalistic capitalism, confiscatory caps on great fortunes, progressive conservatism, representative democracy, civic nationalism, isolationism, civic paternalism and federalism, with guaranteed homesteads, pensions and free education. It rejects laissez-faire and aristocracy.",
        "s": "keynesianism:0.8|paternalistic_capitalism:0.6|Confiscatory_Taxation:0.9|progressive_conservatism:0.7|representative_democracy:0.8|civic_nationalism:0.8|Isolationism:0.7|instrumentalism:0.5|industrialism:0.4|civic_paternalism:0.8|federalism:0.7|laissez_faire:-1|aristocracy:-1|regressive_taxation:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Classical Liberalism": {
        "d": "Holds that individual liberty is the foundation of a good society: civil liberalism and civil libertarian rights, limited government (minarchism), the rule of law, laissez-faire free markets with flat taxation, representative democracy, free trade and non-interventionism abroad. It opposes absolute monarchy, theocracy and state socialism as threats to individual freedom.",
        "s": "laissez_faire:0.9|civil_liberalism:1|minarchism:0.6|representative_democracy:0.5|Non_Interventionism:0.7|civil_libertarianism:0.8|flat_taxation:0.4|absolute:-1|state_socialism:-0.9|theocracy:-0.8|state_enterprise_revenue:-0.7|parecon:-0.7|state_corporatism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neoliberalism": {
        "d": "Favors market liberalization: laissez-faire, privatization, deregulation, free trade and globalism, flat taxation, a limited residual welfare state, civil liberalism, representative democracy and a post-industrial knowledge economy. It rejects state socialism and dirigisme.",
        "s": "laissez_faire:0.7|residualism:0.6|flat_taxation:0.4|Globalism:0.8|post_industrialism:0.4|civil_liberalism:0.5|representative_democracy:0.5|state_socialism:-1|dirigisme:-0.8|mercantilism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Liberalism": {
        "d": "Liberalism combined with nationalism: a laissez-faire free market with flat taxation, conservative liberalism and constitutional representative democracy, cultural nationalism of national unity and strength, and a Realpolitik foreign policy that serves the national interest.",
        "s": "laissez_faire:0.7|flat_taxation:0.4|conservative_liberalism:0.7|representative_democracy:0.6|cultural_nationalism:0.7|Realpolitik:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Social Liberalism": {
        "d": "Individual freedom supported by state action that ensures equal opportunity: civil liberalism and civil libertarian rights, representative democracy, a regulated social market economy, progressive taxation and welfare, with limits on laissez-faire.",
        "s": "social_market:0.6|Progressive_Taxation:0.6|civil_liberalism:1|civil_libertarianism:0.7|representative_democracy:0.7|laissez_faire:-0.5|deliberative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Ordoliberalism": {
        "d": "Holds that a strong state should set the rules of a competitive market (Ordnungspolitik), prevent monopolies and keep economic order, with conservative liberalism, representative democracy and a social market economy. It rejects state socialism and unrestrained laissez-faire.",
        "s": "ordnungspolitik:1|conservative_liberalism:0.5|representative_democracy:0.5|laissez_faire:-0.5|state_socialism:-0.8|social_market:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Bleeding-Heart Liberalism": {
        "d": "Liberalism that treats social justice for the poor as part of a free society. It favors basic income capitalism, a market economy with a universal basic income in place of bureaucratic welfare, together with civil libertarian protection of individual rights, social-progressive reform, representative democracy and a cosmopolitan, globalist concern for all people regardless of nationality.",
        "s": "basic_income_capitalism:0.7|social_progressivism:0.6|civil_libertarianism:0.7|Cosmopolitanism:0.6|Globalism:0.5|representative_democracy:0.6|deliberative_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Bleeding-Heart Libertarianism": {
        "d": "Libertarianism that pairs free markets and a minimal state with concern for social justice and the poor, and a cosmopolitan outlook.",
        "s": "minarchism:0.7|Voluntaryism:0.4|laissez_faire:0.6|basic_income_capitalism:0.4|civil_libertarianism:0.9|progressivism:0.4|Cosmopolitanism:0.7|Globalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Geo-Liberalism": {
        "d": "Liberalism built on land value taxation: shared land rent funds public goods or a basic income, with civil liberties and democracy.",
        "s": "lvt:0.9|mixed_lvt:0.6|basic_income_capitalism:0.5|civil_liberalism:0.7|representative_democracy:0.5|laissez_faire:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Green Liberalism": {
        "d": "Liberal democracy combined with environmental protection through regulation and market tools. It holds that individual rights, representative democracy and an open society are compatible with, and necessary for, a sustainable economy, and it uses carbon pricing, environmental taxes, regulation and green investment within a social market economy. It favors international cooperation on climate and environmental problems and rejects coercive or authoritarian ways of protecting nature.",
        "s": "environmentalism:1|civil_liberalism:0.7|representative_democracy:0.6|social_market:0.5|Progressive_Taxation:0.4|Globalism:0.5|deliberative_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Whiggism": {
        "d": "Holds to constitutional monarchy, with the crown bound by law and answerable to parliament: parliamentary supremacy, civil and religious liberty, conservative liberalism and representative democracy of the propertied and commercial classes, and laissez-faire commerce that protects trade and property.",
        "s": "constitutional:1|conservative_liberalism:0.6|laissez_faire:0.4|representative_democracy:0.5|absolute:-1|ochlocracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Muscular Liberalism": {
        "d": "Defends liberal values assertively: civil liberalism and representative democracy, an interventionist foreign policy that supports liberty abroad, cultural nationalism that expects residents to integrate into the national culture, and civic paternalism that promotes shared civic standards.",
        "s": "civil_liberalism:0.8|Interventionism:0.7|cultural_nationalism:0.5|representative_democracy:0.6|civic_paternalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Liberal Atlanticism": {
        "d": "Liberal democracy and the Atlantic alliance: civil liberalism and civil libertarian rights, representative democracy, civilizationism of a shared Western liberal order, and an interventionist foreign policy that defends the liberal international order.",
        "s": "civil_liberalism:0.8|representative_democracy:0.7|civilizationism:0.6|Interventionism:0.5|civil_libertarianism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Transatlantic Federalism": {
        "d": "Advocates a federal political union of the Atlantic democracies, the United States and Europe: federalism, civilizationism of a shared Western community, globalism, civil liberalism and representative democracy.",
        "s": "federalism:0.8|civilizationism:0.6|Globalism:0.6|civil_liberalism:0.6|representative_democracy:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "New Deal Liberalism": {
        "d": "Roosevelt's liberalism: an active national government using Keynesianism, market regulation and public works for industrialism, social insurance and labor protections (civic paternalism), progressive taxation, civil liberalism and representative democracy. It rejects laissez-faire.",
        "s": "keynesianism:0.9|Progressive_Taxation:0.6|civil_liberalism:0.5|industrialism:0.4|civic_paternalism:0.7|representative_democracy:0.5|laissez_faire:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Venizelism": {
        "d": "Greek liberal nationalism: representative democracy and conservative liberalism, state modernization through industrialism, centralism and civic paternalism, and pan-nationalism and imperialism in the expansion of the Greek nation.",
        "s": "conservative_liberalism:0.5|representative_democracy:0.6|pan_nationalism:0.5|Imperialism:0.6|industrialism:0.4|civic_paternalism:0.4|centralism:0.4|irredentism:0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Liberal Kemalism": {
        "d": "Kemalism read liberally: a secular republic that rejects theocracy, with civil liberalism and civil libertarian rights, representative democracy, civic nationalism and a free-market economy.",
        "s": "civil_liberalism:0.8|civic_nationalism:0.6|representative_democracy:0.6|civil_libertarianism:0.5|laissez_faire:0.4|theocracy:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Liberal Social Authoritarianism": {
        "d": "Authoritarian governance with a liberal social and economic orientation: autocracy, in which one strong ruler or executive holds power that is not subject to popular control or legal restraint; securitism, in which public safety and crime prevention, with surveillance and policing, come before individual privacy; and centralism, a unitary state in which national authority is concentrated and regions only carry out national law. Private enterprise, free markets and wide personal freedom in daily life remain open as long as they do not challenge the order.",
        "s": "autocracy:0.5|securitism:0.4|centralism:0.4|laissez_faire:0.4|permissivism:0.4|civil_libertarianism:-0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Techno-Social Liberalism": {
        "d": "Social liberalism that embraces technology: post-industrialism, a knowledge and digital economy, is the basis of prosperity, and a social market economy balances it with a social safety net and progressive taxation that share the gains of technology. Progressivism prepares people for change, and civil libertarian rights, representative democracy, federalism that disperses power and a globalist openness to the world are essential.",
        "s": "post_industrialism:0.8|social_market:0.5|Progressive_Taxation:0.5|progressivism:0.5|civil_libertarianism:0.6|representative_democracy:0.5|Globalism:0.5|federalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Technoliberalism": {
        "d": "Liberalism built around technology: post-industrialism of digital innovation, civil libertarian and civil liberal freedoms, open global markets (globalism) and cosmopolitanism, with representative democracy.",
        "s": "post_industrialism:0.8|civil_libertarianism:0.7|civil_liberalism:0.7|Globalism:0.6|Cosmopolitanism:0.5|representative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "American Model": {
        "d": "The constitutional federal republic of the United States as an ideal: federalism that divides power between national and state governments, representative democracy, and strong civil liberties that protect individual rights. It rests on civic nationalism, a nation defined by shared constitutional values and citizenship, and a free-enterprise economy with a residual, limited safety net that leaves most welfare to families, communities and the market. Abroad it favors an active, interventionist role in defending allies and the international order.",
        "s": "federalism:0.8|civil_libertarianism:0.7|civil_liberalism:0.6|representative_democracy:0.6|civic_nationalism:0.5|Interventionism:0.5|residualism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Techno-Neoliberalism": {
        "d": "Market liberalization guided by technocratic expertise: technocracy, laissez-faire and flat taxation, a technology-driven post-industrial economy, globalism and cosmopolitanism.",
        "s": "technocracy:0.8|Globalism:0.6|post_industrialism:0.7|flat_taxation:0.4|laissez_faire:0.5|Cosmopolitanism:0.5|ochlocracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Tsaingwenism": {
        "d": "Progressive centrism of Taiwan's Tsai Ing-wen: democracy, civil liberties, environmental protection, social reform, a distinct civic Taiwanese identity and international engagement.",
        "s": "third_way:0.5|progressivism:0.6|representative_democracy:0.7|civic_nationalism:0.7|environmentalism:0.6|civil_libertarianism:0.6|Globalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Liberal Imperialism": {
        "d": "A liberalism of civil liberties, free markets and meritocratic institutions with an assertive imperial foreign policy: laissez-faire and ordnungspolitik, conservative liberalism and civil liberalism, representative democracy and meritocracy, imperialism, civil libertarianism and federalism, taking national greatness as a vehicle of commerce and the rule of law. It rejects isolationism, pacifism and communization.",
        "s": "laissez_faire:0.6|ordnungspolitik:0.7|flat_taxation:0.4|Progressive_Taxation:0.3|conservative_liberalism:0.8|civil_liberalism:0.8|liberal_conservatism:0.5|representative_democracy:0.8|meritocracy:0.7|cultural_nationalism:0.5|civic_nationalism:0.5|Imperialism:1|civil_libertarianism:0.7|federalism:0.4|Isolationism:-1|pacifism:-1|communization:-1|state_socialism:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Liberal Meritocracy": {
        "d": "A liberalism that trusts rule by demonstrated competence: a social market, the third way, progressive taxation, civil liberalism, meritocracy, civic nationalism, interventionism and globalism for human rights, ecomodernism and post-industrialism, civil libertarianism and federalism. It rejects ochlocracy, referendum democracy and isolationism.",
        "s": "social_market:0.7|third_way:0.6|Progressive_Taxation:0.7|civil_liberalism:0.9|meritocracy:1|civic_nationalism:0.7|Interventionism:0.7|Globalism:0.6|post_industrialism:0.5|ecomodernism:0.6|civil_libertarianism:0.9|federalism:0.5|centralism:0.4|ochlocracy:-1|referendum_democracy:-0.8|Isolationism:-0.8|autocracy:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Christian Socialism": {
        "d": "Socialism drawn from Christian teaching: a communitarian ethic of mutual aid, equality and care for the poor, utopian socialist cooperation, rejection of laissez-faire capitalism, a non-interventionist commitment to peace, and a peaceful path to change through representative democracy.",
        "s": "communitarianism:0.8|utopian_socialism:0.5|representative_democracy:0.5|Non_Interventionism:0.5|laissez_faire:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Bolshevism": {
        "d": "Combines Bolshevik-style socialism with national identity and expansion: state socialism and a state-owned economy under a single party (partocracy), collective distribution, cultural and romantic nationalism, imperialism, and rejection of cosmopolitanism, laissez-faire and representative democracy.",
        "s": "state_socialism:0.9|collective_distribution:0.7|partocracy:0.8|cultural_nationalism:0.6|romantic_nationalism:0.5|Imperialism:0.5|laissez_faire:-1|representative_democracy:-0.7|Cosmopolitanism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Democratic Socialism": {
        "d": "Socialism achieved and sustained through representative democracy: market socialism, social or cooperative ownership, free socialism through democratic control, social-progressive welfare, internationalism and alter-globalism. It rejects laissez-faire, partocracy and totalism.",
        "s": "market_socialism:0.5|free_socialism:0.4|representative_democracy:0.8|social_progressivism:0.6|alter_globalism:0.4|Internationalism:0.5|laissez_faire:-0.9|partocracy:-0.8|totalism:-1|deliberative_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Conservative Socialism": {
        "d": "A socialist economy of state socialism, with state ownership and confiscatory taxation of wealth, combined with social conservatism: conservatism and traditionalist conservatism defend tradition, family and inherited custom, and cultural nationalism upholds the nation's culture, while laissez-faire markets and the cultural change of progressivism are turned away.",
        "s": "state_socialism:0.8|Confiscatory_Taxation:0.6|conservatism:0.7|traditionalist_conservatism:0.5|cultural_nationalism:0.5|laissez_faire:-1|progressivism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Paleosocialism": {
        "d": "Socialism joined to paleoconservative culture: state socialism and confiscatory taxation, communitarianism and traditional values, cultural nationalism, paleoconservatism, and isolationism abroad.",
        "s": "state_socialism:0.7|paleoconservatism:0.6|communitarianism:0.6|Isolationism:0.6|Confiscatory_Taxation:0.5|cultural_nationalism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Cybernetic Socialism": {
        "d": "Socialism run through computing and cybernetics: a state-socialist planned economy guided by real-time data and feedback, technocrats and technical expertise, Promethean mastery of technology for progress, digital democracy that widens participation through networks, progressivism and internationalism.",
        "s": "state_socialism:0.6|technocracy:0.6|digital_democracy:0.5|prometheanism:0.6|progressivism:0.6|Internationalism:0.5|dirigisme:0.5|cybernetic_socialism:1|futurism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Utopian Communitarianism": {
        "d": "Builds small model communities on shared ownership and cooperation as a template for a new society: utopian socialism, communitarianism and communal self-rule, in which property and work are shared, education and welfare are communal and members live by reason and harmony, with progressivism that expects success to spread by example.",
        "s": "utopian_socialism:1|communalism:0.8|communitarianism:0.9|progressivism:0.5|collective_distribution:0.5|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Syndicalist Republicanism": {
        "d": "A democratic republic in which worker syndicates control industry: syndicalism with unions in each industry owning or managing production, within a representative democracy that rejects monarchy, with social-progressive and internationalist aims.",
        "s": "syndicalism:1|representative_democracy:0.6|social_progressivism:0.5|Internationalism:0.5|absolute:-1|syndicracy:0.7|subsidiarity:0.4|productive_democracy:0.6|state_corporatism:-0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Left-Eurasianism": {
        "d": "Eurasian civilizational unity (civilizationism) combined with a socialist state economy: state socialism with collective distribution of goods, rule by a single leading party (partocracy), and an alter-globalist opposition to corporate globalization in favor of cooperation among the peoples of the Eurasian space.",
        "s": "civilizationism:0.8|state_socialism:0.6|collective_distribution:0.5|alter_globalism:0.5|partocracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Socialist Kemalism": {
        "d": "Kemalism pushed in a socialist direction: a secular republic that rejects theocracy, civic nationalism, state socialism with a planned economy, industrialism of state-led industrialization, centralism and progressivism.",
        "s": "state_socialism:0.6|civic_nationalism:0.6|industrialism:0.6|centralism:0.5|progressivism:0.5|theocracy:-0.9|dirigisme:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Socialist Technoliberalism": {
        "d": "Market socialism joined to technology and liberal civil rights. It holds that worker-owned or socially owned enterprises competing in a market can replace capitalist ownership, while technology, digital tools and ecological modernization expand democracy, prosperity and sustainability. It insists on strong individual liberties, civil rights and an open society, uses digital democracy to widen participation, supports progressive taxation and wants globalization reformed in a fairer, more democratic direction.",
        "s": "market_socialism:0.6|ecomodernism:0.4|civil_libertarianism:0.6|civil_liberalism:0.5|digital_democracy:0.4|alter_globalism:0.5|Progressive_Taxation:0.5|environmentalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Mugabeism": {
        "d": "Zimbabwean ZANU-PF doctrine: land redistribution, anti-colonial nationalism, pan-African solidarity and dominance of a single party and leader.",
        "s": "agrarian_socialism:0.6|pan_nationalism:0.8|partocracy:0.6|autocracy:0.5|conservatism:0.4|alter_globalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Old Left-Populism": {
        "d": "Traditional left populism: state socialism and confiscatory taxation joined to conservatism, cultural nationalism and legal moralism, with representative democracy and welfare for the working people of the nation.",
        "s": "state_socialism:0.5|Confiscatory_Taxation:0.4|conservatism:0.5|cultural_nationalism:0.5|representative_democracy:0.5|legal_moralism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Left-State Liberalism": {
        "d": "Progressive, cosmopolitan values pursued through strong state direction: cosmopolitanism and globalism, progressivism, progressive taxation, and dirigisme that steers the economy from the center through a unified, centralist administration.",
        "s": "Progressive_Taxation:0.5|progressivism:0.5|Cosmopolitanism:0.6|Globalism:0.6|dirigisme:0.5|centralism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "American Technocracy": {
        "d": "The post-capitalist model of Technocracy Inc.: continental industry run by scientists and engineers with goods shared equally through energy accounting. It holds state socialism, cybernetic socialism, collective distribution, progressivism, technocracy, civic nationalism, isolationism, prometheanism, civic paternalism and federalism, and rejects private finance, laissez-faire and partisan politics.",
        "s": "state_socialism:0.8|cybernetic_socialism:0.7|collective_distribution:1|progressivism:0.8|technocracy:1|civic_nationalism:0.6|Isolationism:0.7|prometheanism:0.8|civic_paternalism:0.5|federalism:0.6|laissez_faire:-1|state_capitalism:-0.8|partocracy:-0.9|representative_democracy:-0.8|Voluntaryism:-1|futurism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Fabian Socialism": {
        "d": "A gradualist British socialism that wins public ownership of key utilities by parliamentary permeation: state socialism and dirigisme, progressive taxation, progressivism, representative democracy and an educated technocratic civil service, civic nationalism, internationalism, post-industrialism, instrumentalism, civic paternalism and municipalism. It rejects laissez-faire and violent revolution.",
        "s": "state_socialism:0.7|dirigisme:0.6|Progressive_Taxation:0.8|progressivism:0.8|representative_democracy:0.8|technocracy:0.6|civic_nationalism:0.5|Internationalism:0.7|post_industrialism:0.5|instrumentalism:0.5|civic_paternalism:0.8|municipalism:0.6|laissez_faire:-1|communization:-1|councilism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Ujamaa": {
        "d": "The African socialism of Julius Nyerere: 'familyhood' in collective rural villages, agrarian socialism, collective distribution, progressive conservatism, one-party partocracy, pan-nationalism, non-interventionism, agrarianism, civic paternalism and regionalism, resting on moral self-reliance. It rejects capitalism, laissez-faire and class war.",
        "s": "agrarian_socialism:1|collective_distribution:0.9|progressive_conservatism:0.6|partocracy:0.7|pan_nationalism:0.8|Non_Interventionism:0.7|agrarianism:1|civic_paternalism:0.7|regionalism:0.6|communalism:0.3|laissez_faire:-1|state_capitalism:-0.7|industrialism:-0.5|communization:-0.6|organic_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Bordigism": {
        "d": "The left communism of Amadeo Bordiga. A single vanguard communist party, the bearer of an unchanging program, leads the proletariat to a dictatorship that abolishes capitalism, markets and money (communization), with collective distribution of goods according to need. It is strictly internationalist and cosmopolitan, rejecting civic nationalism, national struggles and alliances with bourgeois parties, and it rejects representative democracy and electoral politics as well as laissez-faire. Inside the party it practices organic centralism in place of majority votes.",
        "s": "communization:0.8|collective_distribution:0.7|partocracy:0.8|Internationalism:1|Cosmopolitanism:0.6|representative_democracy:-1|laissez_faire:-1|civic_nationalism:-1|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Italian Left Communism": {
        "d": "Revolutionary communism that demands an internationalist, party-led abolition of capitalism: communization of wage labor, money and markets, collective distribution, a revolutionary party (partocracy) that leads the class, and rejection of representative democracy, parliaments, national fronts and laissez-faire.",
        "s": "communization:0.7|collective_distribution:0.7|partocracy:0.6|Internationalism:1|representative_democracy:-0.8|laissez_faire:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Juche": {
        "d": "North Korean doctrine of self-reliance within a leader-centered socialist state: state socialism and collective distribution under a ruling party (partocracy) and an autocratic supreme leader, regimentalism, cultural nationalism that cultivates the nation's traditions, and isolationism that places independence in politics, economy and defense first. It rejects laissez-faire.",
        "s": "state_socialism:0.8|collective_distribution:0.6|partocracy:0.8|autocracy:0.7|cultural_nationalism:0.7|Isolationism:0.7|regimentalism:0.6|laissez_faire:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Mao Zedong Thought": {
        "d": "Marxist-Leninist doctrine adapted to China: agrarian socialism with peasant-based revolution, protracted people's war, continuous revolution and the mass line, under the leadership of the communist party (partocracy). It holds that in a semi-colonial, agrarian country the peasantry is the main revolutionary force, that collective distribution follows revolution, and that class struggle continues under socialism. It rejects laissez-faire and representative democracy.",
        "s": "agrarian_socialism:0.7|collective_distribution:0.7|partocracy:0.8|laissez_faire:-1|representative_democracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Maoism Third Worldism": {
        "d": "Maoism holding that revolution centers on the Third World: anti-imperialism and national liberation through people's war under a party (partocracy), agrarian socialism and collective distribution, an alter-globalist solidarity of exploited nations, and the view that workers in wealthy countries benefit from exploitation. It rejects imperialism and laissez-faire.",
        "s": "agrarian_socialism:0.6|collective_distribution:0.7|partocracy:0.7|alter_globalism:0.5|Imperialism:-1|laissez_faire:-1|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Marxism Leninism Maoism": {
        "d": "Universal Maoism: Marxist-Leninist doctrine plus the thought of Mao Zedong, with a vanguard party (partocracy), people's war and class struggle worldwide, agrarian socialism and collective distribution, and internationalism. It holds that Maoism is a third and higher stage of Marxism with universal validity, that protracted people's war is the strategy for all countries, and that revolution must be continued after the seizure of power. It rejects laissez-faire.",
        "s": "agrarian_socialism:0.6|collective_distribution:0.7|partocracy:0.8|Internationalism:0.6|laissez_faire:-1|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Luxemburgism": {
        "d": "Rosa Luxemburg's revolutionary socialism: mass strikes and workers' councils (councilism) with democracy inside socialism, internationalism and cosmopolitanism, collective distribution and a socialist state that answers to the working class. It rejects party monopoly (partocracy), top-down vanguardism, reformism and laissez-faire.",
        "s": "councilism:0.8|state_socialism:0.4|collective_distribution:0.6|Internationalism:1|Cosmopolitanism:0.6|laissez_faire:-1|partocracy:-0.6|oligarchy:-0.7|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Trotskyism": {
        "d": "Marxism built on permanent revolution: internationalism and cosmopolitanism, collective distribution, a workers' state with state socialism, and a party (partocracy) that leads under workers' democracy while opposing bureaucratic rule. It rejects laissez-faire.",
        "s": "state_socialism:0.5|collective_distribution:0.7|partocracy:0.5|Internationalism:1|Cosmopolitanism:0.5|laissez_faire:-1|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Marxism-Leninism": {
        "d": "Marx and Lenin's doctrine: state socialism with state ownership and a planned economy, collective distribution, a vanguard party (partocracy) with democratic centralism and the dictatorship of the proletariat, and internationalism. It rejects laissez-faire and representative democracy.",
        "s": "state_socialism:1|collective_distribution:0.8|partocracy:0.9|Internationalism:0.6|laissez_faire:-1|representative_democracy:-0.7|dirigisme:0.5|centralism:0.5|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Stalinism": {
        "d": "Marxist-Leninist doctrine as developed under Stalin: state socialism with state-owned central planning, collective distribution, rapid industrialism and collectivization, and a centralized party-state (partocracy) under a dominant autocratic leader, with totalism and hypercentralism over society. It holds that socialism can be built in one country and that class struggle intensifies as socialism advances, justifying strong state power against enemies of the regime, and it rejects laissez-faire.",
        "s": "state_socialism:1|collective_distribution:0.8|partocracy:0.8|autocracy:0.7|industrialism:0.8|totalism:0.6|centralism:0.8|hypercentralism:0.5|laissez_faire:-1|convivialism:-0.6|patchwork:-0.7|panarchy:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Titoism": {
        "d": "Yugoslav communism independent of Moscow: workers' self-management, market socialism, non-alignment and a federal multinational state.",
        "s": "market_socialism:0.8|collective_distribution:0.5|federalism:0.8|Non_Interventionism:0.7|partocracy:0.6|laissez_faire:-1|state_enterprise_revenue:0.7|productive_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Dengism": {
        "d": "Socialism with Chinese characteristics: partocracy with single-party leadership, state capitalism that combines market reform with state ownership of strategic sectors, Realpolitik pragmatism, alternative modernism (a path to modernity of its own), centralism and civic nationalism.",
        "s": "state_capitalism:0.7|partocracy:0.9|alternative_modernism:0.5|Realpolitik:0.6|centralism:0.5|civic_nationalism:0.5|state_socialism:0.3|state_enterprise_revenue:0.9|pragmatism:0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Hoxhaism": {
        "d": "Albanian anti-revisionist Marxist-Leninist doctrine: state socialism with state-owned, planned industrialism, collective distribution, a ruling communist party (partocracy) exercising the dictatorship of the proletariat, and isolationist self-reliance. It rejects laissez-faire and any reconciliation with revisionism.",
        "s": "state_socialism:0.9|collective_distribution:0.8|partocracy:0.8|Isolationism:0.6|industrialism:0.5|laissez_faire:-1|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Castroism": {
        "d": "Cuban revolutionary socialism: a one-party state, state ownership, anti-imperialism, internationalist support for revolutions abroad and social programs. It rests on a revolutionary leadership with strong personal authority, a state-owned planned economy, universal free education and health care as achievements of the revolution, and a nationalism of sovereignty against foreign domination; it also sends aid, doctors and fighters to allied revolutionary movements. It is outward-looking and interventionist, treating solidarity with revolutions abroad as a duty.",
        "s": "state_socialism:0.8|collective_distribution:0.7|partocracy:0.7|autocracy:0.5|Interventionism:0.5|cultural_nationalism:0.5|laissez_faire:-1|dirigisme:0.4|Imperialism:-0.6|Internationalism:0.6|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Guevarism": {
        "d": "Che Guevara's revolutionary doctrine: armed internationalism and interventionism that export revolution through guerrilla warfare, agrarian socialism with a rural base, collective distribution, the new socialist person, moral incentives and social-progressive aims. It rejects laissez-faire markets.",
        "s": "agrarian_socialism:0.5|collective_distribution:0.7|Interventionism:0.7|social_progressivism:0.4|Internationalism:0.8|laissez_faire:-1|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cyber-Communism": {
        "d": "Communist planning through computing and artificial intelligence: state socialism with collective distribution of goods according to need, run by technocrats and automated systems, Promethean mastery of technology that produces abundance, internationalist and social-progressive, rejecting laissez-faire markets and money.",
        "s": "state_socialism:0.7|collective_distribution:0.7|technocracy:0.6|prometheanism:0.6|Internationalism:0.6|social_progressivism:0.4|laissez_faire:-1|cybernetic_socialism:0.8|futurism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "De Leonism": {
        "d": "Daniel De Leon's revolutionary industrial unionism: syndicalism in which workers organize by industry into one big union and replace the political state with an industrial union government, with collective distribution of production, industrialism, internationalism, and rejection of laissez-faire capitalism.",
        "s": "syndicalism:0.8|collective_distribution:0.6|industrialism:0.5|Internationalism:0.5|laissez_faire:-1|syndicracy:0.7|productive_democracy:0.8|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Marxism-Kemalism": {
        "d": "Kemalism fused with Marxism: a planned socialist economy of state socialism and industrialism, collective distribution, party leadership (partocracy), civic nationalism of a secular republic and rejection of theocracy.",
        "s": "state_socialism:0.6|collective_distribution:0.5|civic_nationalism:0.5|partocracy:0.5|industrialism:0.5|theocracy:-0.9|materialism:0.8|rationalism:0.1|empiricism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "National Communism": {
        "d": "A Marxist-Leninist state socialism adapted to national sovereignty: a one-party partocracy, state socialism, collective distribution, social progressivism, cultural nationalism, realpolitik, ecomodernism and industrialism, civic paternalism with discipline, and centralism. It rejects laissez-faire, cosmopolitanism and religious traditionalism.",
        "s": "state_socialism:1|collective_distribution:0.8|social_progressivism:0.7|partocracy:1|cultural_nationalism:0.7|Realpolitik:0.7|industrialism:0.7|ecomodernism:0.4|civic_paternalism:0.6|disciplinarianism:0.5|centralism:0.9|laissez_faire:-1|Cosmopolitanism:-0.8|religious_traditionalism:-0.8|theocracy:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Libertarian Municipalism": {
        "d": "Murray Bookchin's doctrine: municipalism, in which citizen assemblies govern each town, confederalism joining municipalities to replace the state, and communal self-rule and free socialism grounded in social ecology (environmentalism). It rejects centralism and hypercentralism, and is communitarian, internationalist and alter-globalist.",
        "s": "municipalism:1|communalism:0.7|free_socialism:0.6|environmentalism:0.8|confederalism:0.6|communitarianism:0.5|alter_globalism:0.4|Internationalism:0.5|centralism:-0.9|hypercentralism:-1|deliberative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Communalism": {
        "d": "Bookchin's communalism: confederated communes, direct democracy, social ecology and communal ownership. Political power is exercised by citizens in face-to-face assemblies of each town or neighborhood, and communes join in a confederation whose delegates carry out, but do not make, the assemblies' decisions. The economy is municipalized and communal, and harmony with nature is regarded as inseparable from the removal of hierarchy and domination. It rejects the centralized nation-state and the market, and seeks a different, cooperative form of globalization among communities.",
        "s": "communalism:1|confederalism:0.8|free_socialism:0.6|environmentalism:0.8|communitarianism:0.6|collective_distribution:0.5|alter_globalism:0.4|centralism:-0.9|referendum_democracy:0.5|municipalism:0.5|oligarchy:-0.7|deliberative_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Minarcho-Socialism": {
        "d": "Socialism with a minimal state: voluntary cooperative ownership, minimal government and non-intervention abroad.",
        "s": "minarchism:0.7|free_socialism:0.5|market_socialism:0.4|collective_distribution:0.4|Non_Interventionism:0.6|social_progressivism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Libertarian Socialism": {
        "d": "Socialism opposed to state authority: free socialism of worker ownership and direct democracy through councils (councilism) and voluntary association, with collective distribution according to need, anarchism, civil libertarian freedom, internationalism and social-progressive aims. It rejects partocracy, totalism and laissez-faire.",
        "s": "free_socialism:0.8|collective_distribution:0.5|councilism:0.5|anarchism:0.5|social_progressivism:0.4|Internationalism:0.5|civil_libertarianism:0.7|partocracy:-1|totalism:-1|laissez_faire:-1|parecon:0.6|state_corporatism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Council Communism": {
        "d": "Holds that workers' councils should directly run production and society (councilism). Revolution abolishes wage labor, markets and the state (communization), with collective distribution according to need and internationalism among workers. It rejects partocracy, vanguard parties, state socialism, representative democracy and laissez-faire.",
        "s": "communization:0.7|councilism:1|collective_distribution:0.6|Internationalism:0.8|partocracy:-1|state_socialism:-0.8|representative_democracy:-0.7|laissez_faire:-1|oligarchy:-0.7|productive_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Democratic Confederalism": {
        "d": "Abdullah Öcalan's model of stateless democracy: confederalism of self-governing communes (communal self-rule) and assemblies joined in confederation, rejecting centralism and hypercentralism, with environmentalism (ecology), social-progressive gender equality, communitarianism, free socialism through cooperatives, and civil libertarian pluralism.",
        "s": "communalism:0.9|confederalism:1|environmentalism:0.8|communitarianism:0.6|free_socialism:0.5|social_progressivism:0.7|civil_libertarianism:0.5|centralism:-1|hypercentralism:-1|parecon:0.7|multiculturalism:0.9|convivialism:0.6|oligarchy:-0.7|deliberative_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Guild Socialism": {
        "d": "Holds that industries should be owned and run by democratic workers' guilds. Each industry or trade is a self-governing guild of workers, technicians and managers that controls production and the quality of work, in a communitarian order with councils that represent producers and community interests, while the market is rejected as an organizing principle.",
        "s": "guild_socialism:1|councilism:0.4|communitarianism:0.5|laissez_faire:-0.9|syndicalism:0.4|organic_democracy:0.4|productive_democracy:0.5|state_corporatism:-0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Eco-Socialism": {
        "d": "Socialism that places ecology at its center. Environmentalism and conservationism hold that nature has intrinsic value and that growth has limits, so capitalist expansion gives way to sustainable, collectively owned production shaped by need (collective distribution) and organized through free-socialist cooperatives, communal self-rule and community control. It rejects laissez-faire markets and the endless growth of industrialism, and is internationalist because ecological crisis crosses borders.",
        "s": "environmentalism:1|conservationism:0.6|free_socialism:0.5|collective_distribution:0.6|communalism:0.5|Internationalism:0.5|laissez_faire:-1|industrialism:-0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cybersyn Socialism": {
        "d": "Socialist planning with worker participation, using cybernetic feedback and technical management, as in Chile's Project Cybersyn. It holds that a socialist economy can be run by combining real-time data from factories, networks of computers and the judgment of experts with democratic worker input: enterprises remain largely autonomous and send information upward while the central coordinators respond with guidance, so that planning is flexible and responsive. It aims at democratic socialism and technical rationality, keeping state ownership, worker participation in decisions and progressive values.",
        "s": "technocracy:0.6|prometheanism:0.5|collective_distribution:0.6|progressivism:0.5|state_socialism:0.5|laissez_faire:-1|yellow_socialism:0.5|productive_democracy:0.4|futurism:0.3|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Fourierism": {
        "d": "Charles Fourier's utopian socialism: society organized into self-sufficient cooperative communities (communitarianism and communal self-rule), work chosen by passion, and permissivism that frees people from the repression of their desires, together with social-progressive reform such as the emancipation of women. It rejects laissez-faire competition.",
        "s": "utopian_socialism:1|communalism:0.6|communitarianism:0.8|permissivism:0.7|social_progressivism:0.5|laissez_faire:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Gandhian Socialism": {
        "d": "Gandhi's vision of village self-rule: communitarianism with decentralized, local decision-making (it rejects centralism), nonviolence and non-interventionism, simple living and trusteeship in the manner of distributism, agrarian socialism with small-scale cottage industry, and wariness of heavy industrialization (neo-Luddism), with direct popular participation in decisions.",
        "s": "communitarianism:0.8|Non_Interventionism:0.6|neoluddism:0.6|distributism:0.5|agrarian_socialism:0.5|referendum_democracy:0.4|industrialism:-0.8|centralism:-0.9|pacifism:0.7|convivialism:0.7|reputationalism:0.9|organic_democracy:0.5|futurism:-0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Scythianism": {
        "d": "Russian revolutionary populism that sees Russia as an elemental Eurasian force (civilizationism) destined to renew the world through a peasant-based agrarian socialism. Revolution is a spiritual upheaval that sweeps away Western rationalism and bourgeois culture, and its alternative modernism sets out a path to modernity rooted in the country's own spiritual and cultural character.",
        "s": "agrarian_socialism:0.7|civilizationism:0.6|alternative_modernism:0.5|laissez_faire:-0.4|progressivism:-0.4|ochlocracy:0.5|rationalism:0.85|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Proutism": {
        "d": "P. R. Sarkar's Progressive Utilization Theory: cooperatives (market socialism) in a balanced economy with collective distribution of necessities, decentralized planning and confederalism, conservationism and sustainability, and a cosmopolitan, progressive outlook that joins material and spiritual needs, with civil libertarian freedom.",
        "s": "market_socialism:0.4|collective_distribution:0.4|Cosmopolitanism:0.7|conservationism:0.6|civil_libertarianism:0.4|confederalism:0.5|progressivism:0.5|productive_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Geolibertarianism": {
        "d": "Libertarianism holding that land and natural resources belong equally to all: land value tax as the main public revenue, minarchism's minimal state, laissez-faire free markets, civil libertarian and civil liberal rights, and non-interventionism abroad. It rejects state socialism.",
        "s": "lvt:1|laissez_faire:0.6|civil_liberalism:0.6|minarchism:0.7|civil_libertarianism:0.8|Non_Interventionism:0.5|state_socialism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Social Libertarianism": {
        "d": "Libertarianism that provides welfare through a basic income and land value tax within a minimal state and broad civil liberties.",
        "s": "basic_income_capitalism:0.8|lvt:0.7|minarchism:0.5|civil_libertarianism:0.9|social_progressivism:0.5|Globalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Helvetic Model": {
        "d": "Swiss political model: direct democracy, federal or confederal structure, armed neutrality, civil liberties and an open market economy.",
        "s": "referendum_democracy:0.9|confederalism:0.6|federalism:0.6|armed_neutrality:0.8|civil_libertarianism:0.5|conservative_liberalism:0.4|civic_nationalism:0.4|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Minarcho-Distributism": {
        "d": "Distributism, widely owned small property, with a minimal government, community life, traditional values and wariness of technology.",
        "s": "distributism:0.8|free_market_distributism:0.5|minarchism:0.7|communitarianism:0.7|traditionalist_conservatism:0.5|neoluddism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Pirate Politics": {
        "d": "Pirate Party politics: digital democracy of open, transparent, direct participation, civil libertarian and civil liberal protection of privacy, digital rights, copyright reform and open access, basic income capitalism as a response to automation, and a cosmopolitan, borderless outlook.",
        "s": "digital_democracy:0.9|civil_libertarianism:0.9|civil_liberalism:0.5|basic_income_capitalism:0.4|Cosmopolitanism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Agorist Minarchism": {
        "d": "Agorism's counter-economics combined with a minimal state. It holds that people should trade and cooperate through voluntary, untaxed and unregulated markets built outside state control (counter-economics), while accepting a limited night-watchman state confined to protecting rights, property and contracts. Civil libertarian and civil liberal in outlook, it defends free speech, privacy and personal freedom, rests on voluntaryism as the basis of social order, and keeps a non-interventionist foreign policy that stays out of other nations' conflicts.",
        "s": "countereconomics:0.9|minarchism:0.5|civil_libertarianism:0.9|civil_liberalism:0.5|Non_Interventionism:0.6|Voluntaryism:0.5|laissez_faire:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Communal Distributism": {
        "d": "Distributism organized through communities: productive property is widely spread (social-distributist ownership) and held by families, communes and cooperatives. Communitarian and communalist, it governs through municipalism, with local assemblies in towns and confederalism joining communities, social-progressive reform and an alter-globalist, cooperative form of international exchange.",
        "s": "social_distributism:0.8|communalism:0.7|communitarianism:0.8|municipalism:0.5|confederalism:0.4|social_progressivism:0.4|alter_globalism:0.4|distributism:0.7|organic_democracy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Yangism": {
        "d": "Andrew Yang's program: basic income capitalism, a universal basic income as human-centered capitalism, progressivism and ecomodernism, public ownership of personal data, adaptation to automation, representative democracy reform and civic nationalism.",
        "s": "basic_income_capitalism:1|progressivism:0.5|ecomodernism:0.4|civic_nationalism:0.4|representative_democracy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Libertarian Social Democracy": {
        "d": "Welfare through a basic income and public goods funded by land value tax, joined to strong civil libertarian rights and a minimal coercive state (minarchism). Basic income capitalism replaces bureaucratic welfare, progressive taxation and land value tax finance common goods, social-progressive reform and environmentalism are pursued through incentives and public provision, and foreign policy is non-interventionist.",
        "s": "basic_income_capitalism:0.6|civil_libertarianism:0.8|social_progressivism:0.5|minarchism:0.5|lvt:0.5|Progressive_Taxation:0.4|environmentalism:0.4|Non_Interventionism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Progressive Helveticism": {
        "d": "Swiss-style direct democracy and armed neutrality combined with a federal social market economy and progressive and green values: referendum democracy, federalism, progressivism, environmentalism and civil libertarian rights.",
        "s": "referendum_democracy:0.8|armed_neutrality:0.7|federalism:0.6|social_market:0.6|progressivism:0.5|environmentalism:0.5|civil_libertarianism:0.4|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cosmopolitan Distributism": {
        "d": "A left-libertarian union of distributist property and Bookchin's communalism: social distributism, collective distribution beside progressive taxation, social progressivism, communalism, cosmopolitanism, alter-globalism, conservationism and environmentalism, permissivism and civil libertarianism, municipalism. It rejects centralism, laissez-faire and ethnic nationalism.",
        "s": "social_distributism:0.9|collective_distribution:0.5|Progressive_Taxation:0.4|social_progressivism:0.8|communalism:1|Cosmopolitanism:0.9|alter_globalism:0.7|conservationism:0.7|environmentalism:0.6|permissivism:0.6|civil_libertarianism:0.7|municipalism:0.9|convivialism:0.5|centralism:-1|laissez_faire:-0.9|ethnic_nationalism:-1|racial_nationalism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cyber-Federalism": {
        "d": "A federalism of open-source civic platforms and digital direct democracy: the social solidarity economy and the social market, flat taxation or mixed land taxes, civil and conservative liberalism, digital democracy, communitarianism and civic nationalism, post-industrialism and ecomodernism, permissivism and civil libertarianism, federalism with subsidiarity. It rejects autocracy and centralism.",
        "s": "social_solidarity_economy:0.6|social_market:0.5|ordnungspolitik:0.4|flat_taxation:0.4|mixed_lvt:0.4|civil_liberalism:0.7|conservative_liberalism:0.5|digital_democracy:1|communitarianism:0.6|civic_nationalism:0.5|Realpolitik:0.5|armed_neutrality:0.5|ecomodernism:0.6|post_industrialism:0.6|permissivism:0.6|civil_libertarianism:0.8|federalism:1|subsidiarity:0.6|autocracy:-1|centralism:-0.8|hypercentralism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neolibertarianism": {
        "d": "Libertarian economics of free markets and minimal government combined with a strong national defense: laissez-faire, minarchism and flat taxation, civil liberal and civil libertarian rights, federalism, civic nationalism, securitism and an interventionist foreign policy.",
        "s": "laissez_faire:0.8|minarchism:0.6|Interventionism:0.6|securitism:0.4|civic_nationalism:0.4|flat_taxation:0.5|civil_liberalism:0.5|civil_libertarianism:0.4|federalism:0.4|state_enterprise_revenue:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Libertarian Conservatism": {
        "d": "Limited government and free markets combined with social and cultural conservatism: laissez-faire, minarchism, flat taxation and federalism, conservatism and cultural nationalism for tradition, civil libertarian rights, and non-interventionism abroad.",
        "s": "laissez_faire:0.8|minarchism:0.6|conservatism:0.7|cultural_nationalism:0.5|Non_Interventionism:0.6|civil_libertarianism:0.6|flat_taxation:0.5|federalism:0.5|state_enterprise_revenue:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Libertarianism": {
        "d": "Free markets and minimal government within national borders: laissez-faire, minarchism, flat taxation and federalism, cultural nationalism, strict border and security policy (securitism), isolationism abroad and paleoconservative respect for tradition.",
        "s": "laissez_faire:0.7|minarchism:0.6|cultural_nationalism:0.6|Isolationism:0.6|securitism:0.5|flat_taxation:0.5|federalism:0.4|paleoconservatism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Paleolibertarianism": {
        "d": "Free-market libertarianism joined to traditional culture: laissez-faire exchange, voluntaryism and a minimal state (minarchism), civil libertarian rights, a paleoconservative respect for tradition, localism through communitarian and confederal self-government, and a non-interventionist opposition to foreign intervention. It rejects state socialism and is associated with Rothbard and Rockwell.",
        "s": "laissez_faire:1|Voluntaryism:0.6|minarchism:0.4|paleoconservatism:0.5|communitarianism:0.4|Non_Interventionism:0.8|civil_libertarianism:0.6|confederalism:0.5|state_socialism:-1|irredentism:-0.5|state_enterprise_revenue:-0.7|parecon:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Dark Enlightenment": {
        "d": "Neoreaction: neoreactionary rejection of egalitarianism, representative democracy, referendum democracy and progressivism in favor of hierarchy; neocameralist and cameralist governance in which the state is run like a corporation by a sovereign executive; technocapitalism and laissez-faire markets; securitism for order.",
        "s": "neoreactionaryism:1|neocameralism:0.9|technocapitalism:0.7|securitism:0.4|cameralism:0.4|laissez_faire:0.5|representative_democracy:-1|referendum_democracy:-1|progressivism:-1|deliberative_democracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cyber-Libertarianism": {
        "d": "Online freedom: privacy, free speech, decentralization, cryptography and an open internet, with minimal state interference.",
        "s": "civil_libertarianism:1|technocapitalism:0.6|laissez_faire:0.6|minarchism:0.5|Cosmopolitanism:0.5|Globalism:0.4|securitism:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Objectivism": {
        "d": "Ayn Rand's philosophy: reality is objective, reason is the means of knowledge, and egoism, rational self-interest, is the moral ideal. Laissez-faire capitalism under a minimal rights-protecting state (minarchism) with civil liberalism and voluntaryism is the only just system. It rejects state socialism, communitarianism, collective distribution, theocracy and religious authoritarianism.",
        "s": "egoism:1|laissez_faire:1|minarchism:0.8|civil_liberalism:0.6|Voluntaryism:0.4|state_socialism:-1|communitarianism:-1|collective_distribution:-1|religious_authoritarianism:-0.9|theocracy:-1|secular_humanism:0.7|ochlocracy:-0.7|state_enterprise_revenue:-0.7|parecon:-0.7|organic_statism:-0.7|state_corporatism:-0.7|protectionism:-0.5|rationalism:0.85|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Fusionism": {
        "d": "Combines free-market, limited-government economics with traditional social values and strong anticommunism. It holds that freedom and virtue support each other: government should be small, constitutional and federal and the economy free so that individuals can choose to live well, while moral and religious tradition is kept alive by civil society, family and church rather than by state coercion. It supports a firm, interventionist stance against communism abroad and rejects socialism and collectivism entirely.",
        "s": "laissez_faire:0.8|traditionalist_conservatism:0.6|minarchism:0.5|civil_libertarianism:0.5|Interventionism:0.5|federalism:0.4|state_socialism:-1|communization:-1|religious_traditionalism:0.4|state_enterprise_revenue:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Minarcho-Avaritionism": {
        "d": "A minimal-state free-market outlook centered on self-interest and permissive attitudes: laissez-faire exchange with a limited state (minarchism) restricted to protecting persons, property and contracts, egoism that treats the pursuit of wealth and self-interest as legitimate and admirable, and permissivism with no moral or cultural limits on what consenting individuals may do.",
        "s": "laissez_faire:0.8|egoism:0.6|minarchism:0.5|permissivism:0.5|state_enterprise_revenue:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Libertarian Helveticism": {
        "d": "Swiss-style direct democracy and armed neutrality joined to low taxes, free markets and civil liberties.",
        "s": "laissez_faire:0.7|flat_taxation:0.5|referendum_democracy:0.8|armed_neutrality:0.8|civil_libertarianism:0.6|confederalism:0.5|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Yarvinism": {
        "d": "A neoreactionary formalism that replaces democratic politics with sovereign, shareholder-owned joint-stock states: cameralism and laissez-faire, flat or regressive taxation, neoreactionaryism, neocameralism, instrumentalism and industrialism, securitism with discipline, and a global patchwork of city-states with free exit. It rejects representative democracy, ochlocracy and egalitarianism.",
        "s": "cameralism:0.7|laissez_faire:0.6|flat_taxation:0.7|regressive_taxation:0.4|neoreactionaryism:1|neocameralism:1|instrumentalism:0.7|industrialism:0.5|securitism:0.6|disciplinarianism:0.5|patchwork:1|representative_democracy:-1|ochlocracy:-1|referendum_democracy:-1|progressivism:-1|social_progressivism:-1|deliberative_democracy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Landianism": {
        "d": "The accelerationist wing of neoreaction: capitalism as a self-amplifying cybernetic intelligence heading toward a posthuman singularity, with laissez-faire and counter-economics, neoreactionaryism, neocameralism and polycentrism, technocapitalism and posthumanism, permissivism, and competing corporate city-states under a patchwork with free exit. It rejects egalitarian democracy, primitivism and neo-Luddism.",
        "s": "laissez_faire:0.8|countereconomics:0.5|neoreactionaryism:0.9|neocameralism:0.7|polycentrism:0.6|technocapitalism:1|posthumanism:1|permissivism:0.6|patchwork:0.8|confederalism:0.4|representative_democracy:-1|referendum_democracy:-1|progressivism:-0.9|primitivism:-1|neoluddism:-1|conservationism:-0.6|panarchy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Anarcho-Syndicalism": {
        "d": "Holds that revolutionary workers' unions (syndicates) are both the means of struggle and the framework of a free society. Through direct action, general strikes and worker self-management, workers abolish the state and capitalism and run industry through federated syndicates in a confederal, decentralized order. It rejects representative democracy, political parties and centralism in favor of anarchism, collective distribution of production, internationalism among workers of all countries and civil liberties, and accepts industrial production under workers' control. It opposes laissez-faire capitalism.",
        "s": "syndicalism:1|anarchism:0.9|collective_distribution:0.6|confederalism:0.6|Internationalism:0.8|industrialism:0.4|civil_libertarianism:0.5|laissez_faire:-1|partocracy:-1|representative_democracy:-0.9|centralism:-0.8|oligarchy:-0.7|organic_statism:-0.6|state_corporatism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Platformism": {
        "d": "Organizational anarchism: anarchists form a single general federation (confederalism) with a common theoretical and tactical line and collective responsibility, to give ideological direction to the class struggle of workers and peasants. It aims at a stateless communist society of federated communes (communization), free socialism and collective distribution, is internationalist, and rejects laissez-faire, partocracy and any transitional state.",
        "s": "anarchism:0.9|communization:0.6|free_socialism:0.5|collective_distribution:0.6|Internationalism:0.7|confederalism:0.5|laissez_faire:-1|partocracy:-0.8|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Left-Agorism": {
        "d": "Left-wing market anarchist politics: counter-economics and anarchism, with cooperatives and mutual aid, municipalism and alter-globalism, civil libertarian and permissive freedom, social-progressive aims and cosmopolitanism, opposed to corporate capitalism.",
        "s": "countereconomics:0.8|anarchism:0.8|civil_libertarianism:0.7|social_progressivism:0.5|Cosmopolitanism:0.5|alter_globalism:0.4|municipalism:0.4|permissivism:0.4|oligarchy:-0.7|panarchy:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Lys Noir": {
        "d": "A reactionary, rural, anarcho-monarchist outlook: a monarch exists only to keep order and prevent the rise of a state (anarcho-monarchism), reactionaryism seeks a return to tradition, ethnic nationalism centers on ancestral land, isolationism keeps distance from modern society, neo-Luddism rejects industrial technology, and agrarian socialism organizes rural communal life.",
        "s": "agrarian_socialism:0.4|reactionaryism:0.7|anarcho_monarchism:0.8|ethnic_nationalism:0.6|Isolationism:0.5|neoluddism:0.5|communalism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Anarcho-Communism": {
        "d": "Holds that a stateless, classless society should replace the state, private property and wages, with free federated communes and distribution according to need. Its core is the goal of a stateless communist society: it rejects all government, parties and representative democracy, and wants common ownership of land and the means of production, voluntary cooperation by free communes and councils bound together in federation across borders, and strong personal freedoms. It leaves the form of organization open: federations, councils, communes and affinity groups are all compatible with it.",
        "s": "anarchism:1|communization:1|collective_distribution:0.9|confederalism:0.6|Internationalism:0.7|civil_libertarianism:0.6|laissez_faire:-1|partocracy:-1|representative_democracy:-1|oligarchy:-0.7|organic_statism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Solarpunk Anarchism": {
        "d": "Anarchism joined to ecological, solar-powered technology: anarchism and free socialism with technogaianism, decentralized renewable energy and sustainable communities (environmentalism), collective distribution, civil libertarian and social-progressive freedom, cosmopolitanism and an alter-globalist, optimistic vision of the future.",
        "s": "anarchism:0.8|technogaianism:0.8|environmentalism:0.6|free_socialism:0.5|collective_distribution:0.4|alter_globalism:0.4|civil_libertarianism:0.5|Cosmopolitanism:0.5|social_progressivism:0.5|convivialism:0.7|reputationalism:0.7|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Christian Anarchism": {
        "d": "Holds that following the teaching of Jesus means rejecting state coercion and violence. Anarchist and voluntaryist, it favors self-governing voluntary communities (communitarianism), non-interventionism and nonviolence, and civil libertarian freedom of conscience, and rests on religious traditionalism, the authority of scripture and the ethic of love, forgiveness and nonresistance.",
        "s": "anarchism:0.9|Voluntaryism:0.6|religious_traditionalism:0.6|communitarianism:0.7|Non_Interventionism:0.8|civil_libertarianism:0.5|pacifism:0.9|reputationalism:0.9|oligarchy:-0.7|irredentism:-0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Insurrectionary Anarchism": {
        "d": "Anarchism of direct, informal small-group attack on the state and capital: anarchist, egoist and permissive, internationalist and civil libertarian, it rejects partocracy, representative democracy, centralism and formal organizations in favor of affinity groups acting autonomously.",
        "s": "anarchism:1|egoism:0.5|permissivism:0.5|Internationalism:0.5|civil_libertarianism:0.5|partocracy:-1|representative_democracy:-1|centralism:-1|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Catholic Workerism": {
        "d": "Dorothy Day's movement: Christian pacifist anarchism lived through hospitality to the poor, voluntary poverty, personalism and community farms. It rests on religious traditionalism, communitarianism and anarchism, rejects laissez-faire capitalism as well as state coercion, upholds a non-interventionist pacifism that refuses war, and defends civil libertarian freedom of conscience.",
        "s": "anarchism:0.7|religious_traditionalism:0.7|communitarianism:0.8|Non_Interventionism:0.9|civil_libertarianism:0.4|laissez_faire:-1|pacifism:0.9|convivialism:0.7|reputationalism:0.9|irredentism:-0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Mutualism": {
        "d": "Proudhon's doctrine: mutualism of workers' self-management through mutual credit and fair exchange, cooperative possession of property and federation (confederalism), without rent, interest or exploitative profit. Anarchist, communitarian and civil libertarian, it rejects laissez-faire capitalism and state socialism.",
        "s": "mutualism:1|anarchism:0.6|confederalism:0.6|communitarianism:0.5|civil_libertarianism:0.5|laissez_faire:-0.8|state_socialism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Market Anarchism": {
        "d": "Anarchism that relies on voluntary markets and free exchange: voluntaryism, with competing private providers and voluntary associations supplying law, security and dispute resolution, and property rights, contracts and free trade ordering society. It covers a range from right-wing to left-wing market anarchists, some of whom favor cooperative enterprises in markets (market socialism). It values civil libertarian and civil liberal freedoms, laissez-faire exchange across borders, cosmopolitanism and non-interventionism.",
        "s": "anarchism:1|Voluntaryism:0.8|civil_liberalism:0.6|civil_libertarianism:0.7|laissez_faire:0.5|Non_Interventionism:0.5|Cosmopolitanism:0.4|market_socialism:0.3|oligarchy:-0.7|state_enterprise_revenue:-0.7|organic_statism:-0.8|panarchy:0.6|state_corporatism:-0.8|protectionism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Mutualist Distributism": {
        "d": "Distributism achieved through mutual aid and cooperative exchange: mutual-distributism of widely held property, communitarian local life, anarchism and civil libertarian freedom, municipalism, and a non-interventionist stance toward other nations.",
        "s": "mutual_distributism:0.8|anarchism:0.6|communitarianism:0.7|civil_libertarianism:0.5|Non_Interventionism:0.4|municipalism:0.4|distributism:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Panarchism": {
        "d": "Holds that many governments should coexist on the same territory, with each person choosing which to belong to: voluntaryism of free membership, anarchism, civil liberalism, permissivism and tolerance, cosmopolitanism, laissez-faire exchange and non-interventionism.",
        "s": "Voluntaryism:0.8|anarchism:0.5|civil_liberalism:0.6|laissez_faire:0.4|Cosmopolitanism:0.5|permissivism:0.5|Non_Interventionism:0.4|polycentrism:0.9|patchwork:0.9|state_enterprise_revenue:-0.7|panarchy:0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Geoanarchism": {
        "d": "Anarchism joined to Georgist land rent: communities collect the rent on land, with no state and otherwise free markets. It holds that land and natural resources belong equally to everyone, so those who hold land should pay its rental value to the local community or voluntary association, which uses it for common needs; no compulsory government is needed and everything else is left to voluntary markets and civil liberties. Its distinguishing feature is the collective collection of land rent by voluntary communities.",
        "s": "lvt:0.8|anarchism:0.9|laissez_faire:0.5|civil_liberalism:0.5|civil_libertarianism:0.6|Cosmopolitanism:0.4|Non_Interventionism:0.4|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Green Anarchism": {
        "d": "Anarchism centered on ecology: anarchist, decentralized, small-scale communities (communitarianism) joined in a confederation, living in harmony with nature through environmentalism and conservationism, and opposed to industrial society. It favors free socialism, civil libertarian freedom and an alter-globalist solidarity among peoples.",
        "s": "anarchism:1|environmentalism:0.9|conservationism:0.6|communitarianism:0.6|free_socialism:0.5|alter_globalism:0.5|civil_libertarianism:0.5|confederalism:0.4|industrialism:-0.7|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Anarcho-Primitivism": {
        "d": "Anarchist critique of civilization that seeks a return to pre-agricultural, hunter-gatherer life by abolishing technology, domestication and the division of labor.",
        "s": "primitivism:1|anarchism:0.9|Tribalism:0.5|neoluddism:0.6|industrialism:-1|Globalism:-0.9|anti_organizationalism:0.9|oligarchy:-0.7|futurism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Post-Anarchism": {
        "d": "Applies poststructuralist ideas to anarchism: postmodernism critiques fixed human nature and universal truths, while anarchism keeps opposition to authority, with permissivism, civil libertarian freedom, free socialism, confederalism, cosmopolitanism and an alter-globalist solidarity.",
        "s": "postmodernism:0.8|anarchism:0.9|free_socialism:0.4|Cosmopolitanism:0.4|alter_globalism:0.4|permissivism:0.5|civil_libertarianism:0.5|confederalism:0.4|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Post-left": {
        "d": "Post-left anarchy: anarchism and egoism critique the organized left, ideology, work and moralism, favor individual insurrection and permissivism, draw on postmodernism and neo-Luddite suspicion of technology, defend civil libertarian freedom, and reject partocracy and representative democracy.",
        "s": "anarchism:0.9|egoism:0.6|postmodernism:0.5|neoluddism:0.4|permissivism:0.6|civil_libertarianism:0.5|partocracy:-1|representative_democracy:-1|amoralism:0.7|anti_organizationalism:0.9|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Anarcho-Transhumanism": {
        "d": "Anarchism joined to human enhancement: voluntary self-modification, technological freedom without the state, and mutual aid.",
        "s": "anarchism:0.9|transhumanism:0.8|technogaianism:0.4|permissivism:0.5|free_socialism:0.4|civil_libertarianism:0.6|Cosmopolitanism:0.4|confederalism:0.3|oligarchy:-0.7|futurism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Ego-Communism": {
        "d": "Combines egoist self-ownership with communism: a voluntary communism of unique individuals. It holds that each person is sovereign and acts out of self-interest, and that sharing goods and work in common is a free choice made because it benefits those who join, not a duty imposed by the state, morality or class. It is stateless, anti-authoritarian and permissive, rejects imposed collective ideals, and supports an international community of free associations in which goods are distributed as the members agree.",
        "s": "egoism:0.7|communization:0.6|collective_distribution:0.5|anarchism:0.9|permissivism:0.5|Internationalism:0.5|amoralism:0.7|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "National-Anarchism": {
        "d": "Stateless, separate ethnic or cultural communities that govern themselves in a traditional way: anarchism and tribalism, ethnic nationalism and perennial traditionalism, distributism and municipalism, isolationism, and rejection of cosmopolitanism and globalism.",
        "s": "anarchism:0.8|Tribalism:0.8|ethnic_nationalism:0.5|perennial_traditionalism:0.5|Isolationism:0.6|distributism:0.4|municipalism:0.4|Cosmopolitanism:-1|Globalism:-1|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Ego-Mutualism": {
        "d": "The individualist anarchism of Benjamin Tucker, joining Proudhonian mutualism with Stirner's egoism: mutualism, postmodernism and civil liberalism, anarchism, egoism, amoralism, alter-globalism and non-interventionism, permissivism and civil libertarianism, with municipalism and confederalism. It rejects the state, moral dogma and collective ownership.",
        "s": "mutualism:1|postmodernism:0.5|civil_liberalism:0.5|anarchism:1|egoism:1|amoralism:0.7|alter_globalism:0.5|Non_Interventionism:0.6|permissivism:0.7|civil_libertarianism:0.8|municipalism:0.5|confederalism:0.5|reputationalism:0.4|communization:-1|state_socialism:-1|theocracy:-1|totalism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Anarcho-Capitalism": {
        "d": "Holds that the state should be abolished and every service, including law, courts, security and money, supplied by private firms and voluntary associations. It rests on anarchism, absolute laissez-faire markets and private property, voluntaryism that treats taxation as coercion, civil libertarian respect for individual rights and the non-aggression principle, and a non-interventionist approach to the world. It rejects state socialism and communization, and holds that free competition and contract create order and prosperity.",
        "s": "anarchism:1|laissez_faire:1|Voluntaryism:0.9|civil_liberalism:0.6|civil_libertarianism:0.8|Non_Interventionism:0.5|state_socialism:-1|communization:-1|polycentrism:0.7|oligarchy:-0.7|state_enterprise_revenue:-0.7|parecon:-0.7|organic_statism:-0.8|panarchy:0.6|state_corporatism:-0.8|protectionism:-0.8|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Hoppeanism": {
        "d": "Hans-Hermann Hoppe's private-law society: laissez-faire and voluntaryism with an anarchist order of private property, non-interventionism, rejection of representative democracy, and covenant communities (communitarianism) that keep a traditional social order in the paleoconservative spirit.",
        "s": "laissez_faire:1|Voluntaryism:0.8|anarchism:0.6|paleoconservatism:0.4|communitarianism:0.5|Non_Interventionism:0.6|representative_democracy:-1|patchwork:0.5|state_enterprise_revenue:-0.7|parecon:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Bleeding-Heart Anarcho-Capitalism": {
        "d": "Anarcho-capitalist politics with a social conscience: no state, only voluntaryism, private property and laissez-faire markets, joined to social-progressive concern for the poor and for equality. It holds that free markets, open trade (globalism) and civil libertarian freedom are the best means of lifting people up, and that racism, sexism and poverty are best fought through voluntary and civil-society action, charity and boycott. Cosmopolitan, it treats all people as members of one human community and supports open borders and global exchange.",
        "s": "anarchism:0.9|laissez_faire:0.8|Voluntaryism:0.7|social_progressivism:0.5|Cosmopolitanism:0.6|Globalism:0.5|civil_libertarianism:0.7|oligarchy:-0.7|state_enterprise_revenue:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Traditionalist Anarcho-Distributism": {
        "d": "Stateless distributism rooted in religious tradition: distributism of widely held property, anarchism and voluntaryism, communitarian local community, religious traditionalism and legal moralism, non-interventionism and neo-Luddite caution about technology.",
        "s": "distributism:0.8|Voluntaryism:0.6|religious_traditionalism:0.6|anarchism:0.8|communitarianism:0.7|Non_Interventionism:0.5|neoluddism:0.4|legal_moralism:0.4|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Crypto-Anarchism": {
        "d": "Uses cryptography, anonymous digital currency and encrypted networks to escape state control and protect privacy. It holds that private communication and untraceable digital transactions will, through technology rather than politics, weaken the state's ability to tax, surveil and regulate, and let people trade freely in a counter-economy beyond its reach. Privacy is treated as the foundation of freedom. It is anarchist and voluntarist and supports free markets and global digital networks.",
        "s": "countereconomics:0.7|civil_libertarianism:1|anarchism:0.8|Voluntaryism:0.7|civil_liberalism:0.5|technocapitalism:0.5|Cosmopolitanism:0.5|Globalism:0.4|laissez_faire:0.5|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Avaritionism": {
        "d": "Stateless capitalism driven by unrestrained pursuit of wealth and self-interest. It rejects the state and holds that voluntary exchange between self-interested individuals, with no moral, legal or cultural restriction on profit, is the proper organizing principle of society. Greed and the accumulation of wealth are treated as legitimate motives and as the engine of progress, supported by technology-driven capitalism, and personal conduct is likewise left permissive.",
        "s": "laissez_faire:0.8|egoism:0.8|anarchism:0.6|Voluntaryism:0.5|technocapitalism:0.5|permissivism:0.5|amoralism:0.7|polycentrism:0.7|state_enterprise_revenue:-0.7|panarchy:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Autarchism": {
        "d": "Holds that each person is sovereign over themselves and that no government should rule over the individual: anarchism and self-ownership, egoism in which each person acts as their own authority, civil libertarian and civil liberal freedom to control body, property and choices as long as others are not harmed, voluntaryism in all dealings, laissez-faire exchange, and isolationist self-sufficiency and independence from other communities.",
        "s": "egoism:0.6|anarchism:0.9|Voluntaryism:0.7|civil_liberalism:0.5|civil_libertarianism:0.8|laissez_faire:0.5|Isolationism:0.4|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Free-Market Anarcho-Distributism": {
        "d": "Stateless distributism that relies on free-market distributism: property stays widely distributed through voluntary exchange, anarchism and voluntaryism replace the state, communitarian local community and civil libertarian freedom shape social life, and a non-interventionist stance keeps the community out of foreign quarrels.",
        "s": "free_market_distributism:0.8|Voluntaryism:0.6|anarchism:0.8|communitarianism:0.6|civil_libertarianism:0.6|Non_Interventionism:0.4|laissez_faire:0.5|distributism:0.6|oligarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Agorism": {
        "d": "A revolutionary market anarchism that starves the state through counter-economics: untaxed, voluntary market activity, voluntaryism in funding, civil liberalism, anarchism, egoism and cosmopolitanism, non-interventionism, permissivism and civil libertarianism, municipalism and confederalism, with polycentric arbitration and defense. It rejects taxation of every kind and all state power.",
        "s": "countereconomics:1|Voluntaryism:1|civil_liberalism:0.6|anarchism:1|egoism:0.6|Cosmopolitanism:0.5|Non_Interventionism:0.8|permissivism:0.7|civil_libertarianism:0.8|polycentrism:0.6|municipalism:0.4|confederalism:0.5|flat_taxation:-1|Progressive_Taxation:-1|state_socialism:-1|totalism:-1|centralism:-1|organic_statism:-0.8|panarchy:0.6|state_corporatism:-0.8|protectionism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Left-Accelerationism": {
        "d": "Holds that technology and automation should be accelerated and reclaimed to move beyond capitalism: Promethean mastery of technology, collective distribution of its abundance, internationalism, social-progressive aims, free socialism and digital democracy. It rejects laissez-faire markets.",
        "s": "prometheanism:0.8|collective_distribution:0.5|free_socialism:0.4|digital_democracy:0.3|Internationalism:0.6|social_progressivism:0.5|laissez_faire:-1|convivialism:-0.6|futurism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Right-Accelerationism": {
        "d": "Holds that capitalism and technological disruption should be sped up to dismantle the state and the existing social order. It regards technology-driven capitalism as a force that is already eroding political institutions and social structures, and believes that intensifying it, through deregulation, automation and markets outside state control (counter-economics), will break up democratic government and existing social norms and clear the way for a new order. It has an intended outcome: the replacement of the current order by one shaped by the market and technology.",
        "s": "technocapitalism:0.8|countereconomics:0.4|laissez_faire:0.6|representative_democracy:-0.6|anarchism:0.4|patchwork:0.9|futurism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Effective Accelerationism": {
        "d": "Holds that technological progress, especially artificial intelligence, should be accelerated without restrictive regulation. Technocapitalism treats markets and technological evolution as the engines of progress, laissez-faire competition drives innovation, Promethean mastery of technology and extropian expansion of intelligence are the goals, and calls to slow or halt technology (neo-Luddism) are rejected.",
        "s": "technocapitalism:0.8|laissez_faire:0.8|prometheanism:0.6|extropianism:0.5|neoluddism:-1|state_enterprise_revenue:-0.7|futurism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Unconditional Accelerationism": {
        "d": "Holds that the runaway process of capitalism and technology cannot be stopped or steered and should be accelerated for its own sake. It sees technological and economic acceleration as an impersonal, autonomous force beyond human control, moral judgment or political direction, so that no party, state or ideology can plan its outcome. It sets no end state or social goal for the process; its only position is to let it proceed and to speed it up.",
        "s": "techno_fatalism:0.9|technocapitalism:0.7|technocracy:-0.5|amoralism:0.7|futurism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Neo-Libertarian Falangism": {
        "d": "An internet-meme ideology built on purpose from two things that conflict: Falangist and libertarian ideas. It takes yellow socialism's class cooperation between workers and employers in syndicates serving the nation, religious traditionalism of Catholic culture, ethnic nationalism and imperialism in an imperial vision of Hispanic unity, and from libertarianism a minimal night-watchman state (minarchism) and civil libertarianism. The joke and the doctrine are the same contradiction: devotion to the nation and its mission together with a state that stays as small as possible.",
        "s": "yellow_socialism:0.5|religious_traditionalism:0.5|minarchism:0.5|ethnic_nationalism:0.5|Imperialism:0.5|civil_libertarianism:0.4|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Ingsoc": {
        "d": "The fictional doctrine of Orwell's Nineteen Eighty-Four, called English Socialism: a single party with total control over politics, language and thought, in permanent war, holding power as an end in itself. The Party, personified by Big Brother, rules Oceania as a pyramid of the Inner Party, the Outer Party and the proles. It owns everything collectively in its own name, watches every person through telescreens and the Thought Police, and punishes even private thoughts that depart from orthodoxy. It rewrites records so that the past is whatever the Party says, shrinks language through Newspeak until dissent cannot be expressed, and trains citizens in doublethink, the habit of holding two contradictory beliefs at once. Perpetual war uses up surplus production and keeps the population poor, fearful and loyal. Its inner purpose, as the Party's elite understand it, is power for its own sake.",
        "s": "state_socialism:0.6|partocracy:1|totalism:1|hypercentralism:0.9|Imperialism:0.5|postmodernism:0.4|civil_libertarianism:-1|representative_democracy:-1|polycentrism:-0.6|reputationalism:-0.6|subsidiarity:-0.7|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Neo-Bolshevism": {
        "d": "The fictional official doctrine of Eurasia in Nineteen Eighty-Four, one of the three rival superstates. It presents itself as the heir of Bolshevism: state socialism and collective distribution under a ruling party (partocracy), industrialism, totalism and hypercentralism. In practice it is an oligarchical collectivism, with a pyramid of ranks, a leader revered as semi-divine and a permanent war economy that keeps the population poor and obedient.",
        "s": "state_socialism:0.9|collective_distribution:0.8|partocracy:0.9|industrialism:0.6|totalism:0.5|hypercentralism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Obliteration of the Self": {
        "d": "The fictional official doctrine of Eastasia in Nineteen Eighty-Four, one of the three rival superstates. The novel gives it a Chinese name usually translated as Death-Worship and says it is better rendered as Obliteration of the Self: totalism erases the individual into the collective, hypercentralism concentrates all authority in the Party, ethical statism places the state above the person, and state socialism owns what remains.",
        "s": "totalism:1|hypercentralism:0.8|ethical_statism:0.6|state_socialism:0.5|partocracy:0.8|polycentrism:-0.6|reputationalism:-0.6|subsidiarity:-0.7|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "World State Fordism": {
        "d": "The fictional order of Huxley's Brave New World: globalism of a single world state, hypercentralism and technocracy under Controllers, state capitalism of consumption, and transhumanism of engineered castes (Alphas to Epsilons) produced and conditioned from birth, with soma and casual pleasure. It rejects civil libertarian freedom, putting stability and community above truth, art and liberty.",
        "s": "state_capitalism:0.6|technocracy:0.8|Globalism:1|transhumanism:0.6|hypercentralism:0.6|civil_libertarianism:-0.7|ochlocracy:-0.7|mercantilism:-0.6|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Gileadism": {
        "d": "The fictional regime of The Handmaid's Tale: a totalism in which a Christian theocracy rules by religious law and religious traditionalism, with religious nationalism, centralism, strict gender roles, compulsory reproduction and pervasive surveillance. Society is divided by sex and rank, and the regime rejects civil libertarian freedom, permissivism and representative democracy, persecuting other faiths and punishing dissidents.",
        "s": "theocracy:1|religious_traditionalism:1|religious_nationalism:0.8|totalism:0.9|centralism:0.7|civil_libertarianism:-1|permissivism:-1|representative_democracy:-1|securitism:0.6|amoralism:-0.7|secular_humanism:-0.8|reputationalism:-0.6|anti_organizationalism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "One State Benefactorism": {
        "d": "The fictional order of Zamyatin's We: totalism and hypercentralism under an autocratic Benefactor, a technocracy of reason and mathematics (prometheanism) in which citizens are numbers who live in glass buildings and follow a Table of Hours. Personal independence and individual will have no place, since freedom is held to cause unhappiness and imagination is a disease.",
        "s": "totalism:1|hypercentralism:0.9|technocracy:0.6|autocracy:0.6|prometheanism:0.5|civil_libertarianism:-1|egoism:-1|polycentrism:-0.6|reputationalism:-0.6|subsidiarity:-0.7|patchwork:-0.7|anti_organizationalism:-0.7|panarchy:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Cyberpunk Corpostatism": {
        "d": "Science-fiction order in which megacorporations act as states. Neocameralism: the state is a joint-stock corporation run by its owners; laissez-faire markets and technocapitalism drive technology; securitism: private security forces watch and protect; transhumanism: body augmentation, cybernetics and AI are available to those who can pay.",
        "s": "laissez_faire:0.8|neocameralism:0.9|technocapitalism:0.7|securitism:0.6|transhumanism:0.5|corporatocracy:0.9|regressive_taxation:0.9|oligarchy:0.9|state_enterprise_revenue:-0.7|state_corporatism:0.5|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Fireman Statism": {
        "d": "The fictional regime of Fahrenheit 451. Totalism seeks the complete eradication of the private sphere: individual conscience and inner thought are subordinate to the state, and an autocratic, centralized authority decides what may be read, thought and said. Firemen burn books, citizens are encouraged to denounce readers, and mass media and shallow amusements keep the population pacified. Censorship, informers and conformity replace freedom of expression, and the regime rests on the people's own preference for comfort and for avoiding offense.",
        "s": "autocracy:0.5|totalism:0.6|centralism:0.5|civil_libertarianism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1",
        "low": 1
    },
    "Soylentism": {
        "d": "A fictional neo-Malthusian survival regime: facing overpopulation, ecological ruin and food depletion, an authoritarian state-industrial monopoly rules by state capitalism, reactionary modernism, autocracy, isolationism, industrialism, rationing and totalism with centralized control. It rejects civil libertarianism, permissivism and laissez-faire.",
        "s": "state_capitalism:0.9|reactionary_modernism:0.5|autocracy:0.9|Isolationism:0.7|industrialism:0.8|totalism:0.9|centralism:0.8|civil_libertarianism:-1|permissivism:-1|laissez_faire:-0.8|environmentalism:-0.5|referendum_democracy:-0.9|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Burgundian System": {
        "d": "A fictional ultra-totalitarian regime from an alternate-history setting, ruled by an SS state that organizes the whole population into a slave-labor economy: state socialism, collective distribution, reactionary modernism, stratocracy, racial nationalism, isolationism, techno-fatalism, totalism and hypercentralism. It rejects every liberal and humanist value, from civil libertarianism to cosmopolitanism.",
        "s": "state_socialism:0.7|collective_distribution:0.6|reactionary_modernism:0.7|stratocracy:1|racial_nationalism:1|Isolationism:0.8|techno_fatalism:0.7|totalism:1|hypercentralism:1|civil_libertarianism:-1|civil_liberalism:-1|permissivism:-1|Cosmopolitanism:-1|secular_humanism:-1|multiculturalism:-1|pacifism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Russian Imperial Cult": {
        "d": "A fictional eschatological regime of a holy empire under an absolute theocratic regency: state capitalism, confiscatory taxation, religious traditionalism, absolute monarchy, ethnic nationalism, isolationism, industrialism, discipline through terror, and hypercentralism. It rejects secular humanism, civil libertarianism and every form of pluralism.",
        "s": "state_capitalism:0.6|Confiscatory_Taxation:0.5|religious_traditionalism:1|absolute:1|theocracy:0.6|ethnic_nationalism:0.9|Isolationism:0.7|industrialism:0.5|disciplinarianism:0.8|hypercentralism:0.9|secular_humanism:-1|civil_libertarianism:-1|permissivism:-1|multiculturalism:-1|Cosmopolitanism:-1|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Nihilist Anarchism": {
        "d": "Combines philosophical nihilism with anarchism. It rejects inherent meaning, objective moral foundations and the assumption that established political or social institutions possess an unquestionable right to authority. It favors individual autonomy and opposition to imposed hierarchies, while leaving room for voluntary association and self-organized forms of cooperation.",
        "s": "anarchism:1|anti_organizationalism:0.5|civil_libertarianism:0.5|egoism:0.4|ethical_statism:-0.8|centralism:-0.8|autocracy:-0.8|partocracy:-0.7|religious_traditionalism:-0.5|nihilism:0.95|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Paetel's National Bolshevism": {
        "d": "The state socializes industry and land and plans the economy for the whole nation, because only common ownership can free the working people from capitalist exploitation (State Socialism). The state is built on councils of workers, peasants and soldiers, because the producing people should govern themselves and not be ruled through parliaments or corporations (Councilism). The nation is a community of shared language, culture and fate, and it is the highest value, because only a united people can carry out the socialist revolution (Cultural Nationalism). A military alliance with the revolutionary state to the east against the Western powers is sought, since the nation can free itself only by breaking the grip of the dominant capitalist states while staying sovereign (Alter-Globalism). Goods and services are shared by the community according to need, since the socialist nation owes every member a secure life (Collective Distribution). A path to modernity of its own, outside the model of the liberal and capitalist West, is followed because the renewal of the nation must come from its own revolution (Alternative Modernism). Lands and peoples of the nation that lie outside its borders are claimed back, because the settlement imposed on the defeated people is unjust (Irredentism). The nation is a living community with a youthful spirit of its own, since a renewed people draws strength from the ideals of its youth movement (Romantic Nationalism). A party of dedicated revolutionaries leads the struggle, because a disciplined vanguard must carry the revolution through (Partocracy). A market left free of regulation is rejected since capital enslaves the working people (against Laissez-Faire). Elected representatives who govern for rival parties are rejected because the democratic-capitalist system serves the owners of capital (against Representative Democracy). A single human community with no borders, as in world communism, is rejected, because the liberation of peoples begins with a sovereign socialist nation (against Cosmopolitanism). Defining the nation by race and descent is rejected since the national community is united by culture and shared fate, not by blood (against Racial Nationalism). Open borders and free exchange among all countries are rejected since global trade subjects the nation to foreign capital (against Globalism). The protection of individual rights and expression against the community is rejected, because bourgeois freedom dissolves the bonds of the people (against Civil Liberalism).",
        "s": "state_socialism:1|councilism:1|cultural_nationalism:1|alter_globalism:0.8|collective_distribution:0.5|alternative_modernism:0.6|irredentism:0.5|romantic_nationalism:0.4|partocracy:0.4|laissez_faire:-1|representative_democracy:-1|Cosmopolitanism:-0.8|racial_nationalism:-0.8|Globalism:-0.7|civil_liberalism:-0.7|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "National Radicalism": {
        "d": "A Polish nationalist and authoritarian doctrine associated with the National Radical Camp (ONR), founded in 1934. It envisioned Poland as a Catholic national state, with public and economic life organized according to Catholic principles, hierarchy and corporatist structures. It rejected parliamentary democracy, liberalism and Marxism, advocating a strong state and the subordination of individual political interests to the national community. Its nationalism was ethnically exclusionary and explicitly antisemitic, promoting the marginalization and exclusion of Jews from national life. The movement emphasized Catholic traditionalism, national solidarity, social discipline and centralized political authority. The original ONR split in 1934 into ONR-ABC and ONR-Falanga, whose later programmes developed in different directions.",
        "s": "social_market:0.15|rhine_capitalism:0.1|paternalistic_capitalism:0.45|social_solidarity_economy:0.35|ordnungspolitik:0.1|residualism:-0.4|basic_income_capitalism:-0.6|laissez_faire:-1|countereconomics:-0.8|state_capitalism:0.3|state_socialism:-0.6|dirigisme:0.7|keynesianism:0.25|third_way:-0.45|neo_corporatism:0.3|corporatism:1|social_corporatism:0.4|state_corporatism:1|yellow_socialism:0.75|mutualism:-0.2|guild_socialism:0.25|syndicalism:0.15|market_socialism:-0.5|free_socialism:-0.9|communization:-1|utopian_socialism:-0.85|mutual_distributism:0.3|social_distributism:0.55|agrarian_socialism:-0.4|distributism:0.7|feudalism:-0.35|cameralism:0.45|free_market_distributism:0.1|parecon:-0.75|corporatocracy:-0.9|hierarchical_communism:-0.85|cybernetic_socialism:-0.5|ghent_system:0.15|primitivism:-0.85|neoluddism:-0.45|agrarianism:0.3|conservationism:0.35|environmentalism:-0.1|instrumentalism:0.5|industrialism:0.5|post_industrialism:-0.4|ecomodernism:-0.15|technogaianism:-0.3|prometheanism:0.35|technocapitalism:-0.75|extropianism:-0.8|techno_fatalism:-0.5|transhumanism:-0.95|posthumanism:-1|convivialism:0.15|postmodernism:-1|civil_liberalism:-1|progressivism:-0.9|social_progressivism:-1|conservative_liberalism:-0.75|liberal_conservatism:-0.65|progressive_conservatism:-0.45|conservatism:0.15|traditionalist_conservatism:0.34|reactionaryism:-0.23|paleoconservatism:0.45|neoreactionaryism:-0.55|religious_traditionalism:1|perennial_traditionalism:0.2|reactionary_modernism:0.8|alternative_modernism:0.65|secular_humanism:-1|amoralism:-1|futurism:0.25|civil_libertarianism:-1|permissivism:-1|civic_paternalism:0.8|legal_moralism:0.9|securitism:0.75|disciplinarianism:0.9|regimentalism:0.85|totalism:0.8|retributivism:0.7|reputationalism:0.4|theocracy:0.35|absolute:-0.3|ethical_statism:1|religious_authoritarianism:0.8|autocracy:0.9|anarchism:-1|partocracy:-0.6|representative_democracy:-1|referendum_democracy:-0.55|councilism:-0.4|communalism:-0.5|digital_democracy:-0.7|constitutional:-0.75|minarchism:-0.95|meritocracy:0.3|technocracy:0.15|stratocracy:0.55|aristocracy:0.2|anarcho_monarchism:-0.95|neocameralism:-0.85|syndicracy:0.45|demarchy:-0.85|polycentrism:-0.8|oligarchy:-0.5|semi_constitutional:-0.45|ochlocracy:-0.85|deliberative_democracy:-0.75|organic_democracy:0.6|productive_democracy:0.45|organic_statism:0.9|Isolationism:0.1|Non_Interventionism:0.15|Realpolitik:0.6|Imperialism:0.55|Interventionism:0.2|Globalism:-0.7|armed_neutrality:0.25|Internationalism:-0.7|alter_globalism:-0.45|irredentism:0.6|pacifism:-0.95|mercantilism:0.6|Cosmopolitanism:-1|civic_nationalism:-0.7|cultural_nationalism:0.9|religious_nationalism:0.9|ethnic_nationalism:1|pan_nationalism:0.35|racial_nationalism:0.65|Tribalism:0.4|egoism:-1|communitarianism:0.8|romantic_nationalism:0.7|civilizationism:0.55|multiculturalism:-1|municipalism:-0.15|confederalism:-0.65|federalism:-0.6|regionalism:-0.35|centralism:0.8|hypercentralism:0.3|subsidiarity:0.25|suzerainty:0.3|anti_organizationalism:-1|patchwork:-0.9|panarchy:-1|Voluntaryism:-0.95|lvt:0.15|mixed_lvt:0.2|tariff_funding:0.65|fair_tax:-0.3|flat_taxation:-0.35|Progressive_Taxation:0.45|Confiscatory_Taxation:0.35|collective_distribution:0.2|regressive_taxation:-0.4|state_enterprise_revenue:0.6|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    },
    "Anarcho-Fascism": {
        "d": "A decentralist doctrine from Jonas Nilsson's book Anarcho-Fascism: Nature Reborn (2017): government authority should be practiced in the smallest possible units able to keep their own sovereignty, beginning with the family, whose head is its authority both inside and out, and defended by a generally armed population and local militias instead of a central army or bureaucracy (patchwork, subsidiarity and confederalism, with centralism and hypercentralism rejected). The state exists only to defend its people in war and to help them flourish, and it serves the interests of its own kin and in-group (tribalism, ethnic nationalism and communitarianism) within a shared Western civilization (civilizationism) and an armed neutrality abroad. It holds that falsehoods contrary to nature, such as feminism and universal human rights, are the cause of Western decline, and it calls for a traditional, family-centered and masculine order (traditionalist conservatism and reactionaryism). It rejects cosmopolitanism, globalism, multiculturalism, progressivism, social progressivism and civil liberalism.",
        "s": "patchwork:0.9|subsidiarity:0.6|confederalism:0.5|centralism:-0.8|hypercentralism:-1|Tribalism:0.6|civilizationism:0.5|communitarianism:0.5|ethnic_nationalism:0.4|Cosmopolitanism:-1|multiculturalism:-0.7|armed_neutrality:0.6|Globalism:-1|traditionalist_conservatism:0.4|reactionaryism:0.4|social_progressivism:-0.9|progressivism:-0.8|civil_liberalism:-0.6|anarchism:0.7|ethical_statism:0.7|mutualism:0.61|corporatism:0.5|laissez_faire:0.56|rationalism:0.1|empiricism:0.1|materialism:0.1|idealism:0.1|pragmatism:0.1|existentialism:0.1|nihilism:0.1|stoicism:0.1|utilitarianism:0.1|deontology:0.1"
    }
}